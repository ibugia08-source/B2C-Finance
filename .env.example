# =====================================================================
# B2C FINANCE — variáveis de ambiente (MODELO)
#
# Este arquivo aponta para o AMBIENTE LOCAL por padrão, de propósito
# (03 §4.6: ".env local nunca aponta para produção por padrão").
# Copie para .env e siga docs/AMBIENTES.md.
# =====================================================================

# ===== Ambiente declarado =====
# local | staging | production — os scripts que alteram dados exigem que
# este valor BATA com o banco configurado abaixo (scripts/guard.ts).
APP_ENV="local"

# ===== Banco =====
# LOCAL (padrão): Postgres embarcado, sem Docker — ver docs/AMBIENTE_DEV.md.
#   Subir:  node .devdb/start-db.mjs        (a partir de ~/Desktop/B2C-FINANCE)
POSTGRES_PRISMA_URL="postgres://b2cdev:b2cdev@127.0.0.1:55432/b2c_finance_dev"
POSTGRES_URL_NON_POOLING="postgres://b2cdev:b2cdev@127.0.0.1:55432/b2c_finance_dev"

# STAGING (banco separado, mesma instância local): use .env.staging.example
# PRODUÇÃO: NUNCA neste arquivo. Os valores reais vivem só na Vercel
# (Settings → Environment Variables). Para depurar produção, use uma cópia
# restaurada de backup em staging — nunca o banco de produção.

# ===== Sessão =====
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET="troque-por-um-segredo-de-32+chars"

# ===== Supabase (client + storage de arquivos) =====
# Vazio no local: o upload cai no armazenamento de desenvolvimento.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
B2C_STORAGE_BUCKET="b2c-finance-files"
