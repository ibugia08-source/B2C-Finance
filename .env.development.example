# =====================================================================
# AMBIENTE DE DESENVOLVIMENTO — banco PRÓPRIO e VAZIO (nunca produção)
# =====================================================================
# Como usar: copie este arquivo para `.env` (o Prisma CLI e os scripts leem
# o `.env`, não o `.env.development`) e preencha com o projeto Supabase de
# desenvolvimento. Passo a passo completo: docs/AMBIENTE_DEV.md
#
#   cp .env.development.example .env
#
# ⚠️ Guarde o .env atual antes de sobrescrever — ele aponta para PRODUÇÃO:
#   cp .env .env.producao.backup
# =====================================================================

# ===== Banco (Supabase — projeto de DESENVOLVIMENTO) =====
# Supabase → projeto dev → Connect → ORMs → Prisma
# POSTGRES_PRISMA_URL      = conexão COM POOL, porta 6543 (app em runtime)
# POSTGRES_URL_NON_POOLING = conexão DIRETA, porta 5432 (migrations)
POSTGRES_PRISMA_URL="postgres://postgres.SEU_REF_DEV:SENHA@aws-1-sa-east-1.pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true"
POSTGRES_URL_NON_POOLING="postgres://postgres.SEU_REF_DEV:SENHA@aws-1-sa-east-1.pooler.supabase.com:5432/postgres?sslmode=require"

# ===== Sessão =====
# Gere um segredo NOVO (diferente do de produção):
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET="troque-por-um-segredo-novo-de-32+chars"

# ===== Admin criado pelo seed de desenvolvimento =====
# Sem ADMIN_PASSWORD o seed falha de propósito (nada de senha padrão no repo).
ADMIN_NAME="Admin B2C Finance"
ADMIN_EMAIL="admin@b2cfinance.local"
ADMIN_PASSWORD="escolha-uma-senha-forte"

# ===== Supabase (storage de arquivos) =====
# Opcional em dev: sem estas variáveis, os uploads caem no disco local
# (.uploads/). Preencha só se for testar contratos/documentos de verdade.
NEXT_PUBLIC_SUPABASE_URL="https://SEU_REF_DEV.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="anon-key-do-projeto-dev"
SUPABASE_SERVICE_ROLE_KEY="service-role-key-do-projeto-dev"
B2C_STORAGE_BUCKET="b2c-finance-files-dev"
