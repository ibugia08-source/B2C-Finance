      "notes": "GET /knowledge/documents (scope knowledge.read).",
      "notesInFlow": true
    },
    {
      "parameters": {
        "jsCode": "// Confere o pacote antes de apagar qualquer coisa: se a API falhou, a\n// coleção atual fica intacta.\nconst r = $input.first().json || {};\nif (r.success !== true || !r.data || !Array.isArray(r.data.trechos) || r.data.trechos.length === 0) {\n  throw new Error('A API não devolveu a base de conhecimento (confira o scope knowledge.read). Nada foi apagado.');\n}\nif (r.data.embedding.model !== \"text-embedding-3-small\") {\n  throw new Error('Modelo de embedding do pacote (' + r.data.embedding.model + ') diferente do workflow: gere o workflow de novo.');\n}\nif (!$env.QDRANT_URL) throw new Error('QDRANT_URL não configurado.');\nreturn [{ json: { collection: r.data.collection, version: r.data.version, trechos: r.data.trechos.length } }];"
      },
      "name": "Conferir pacote",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        200
      ],
      "notes": "Pacote válido antes de apagar a coleção.",
      "notesInFlow": true
    },
