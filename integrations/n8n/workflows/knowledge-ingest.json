    {
      "parameters": {
        "jsCode": "// Um item por trecho: texto + metadados (documento, seção, fonte, versão).\nconst pacote = $('API: base de conhecimento').first().json.data;\nreturn pacote.trechos.map((t) => ({ json: { text: t.text, ...t.metadata, trechoId: t.id, versao: pacote.version } }));"
