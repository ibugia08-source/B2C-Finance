# =============================================================================
# B2C Finance × n8n — variáveis de ambiente (EXEMPLO, sem nenhum segredo real)
# =============================================================================
# Copie para o ambiente do n8n (docker-compose .env, variáveis do servidor ou
# do n8n Cloud). NUNCA versione o arquivo preenchido.
#
# TOKENS e CHAVES vão nas CREDENCIAIS do n8n (criptografadas no banco do n8n),
# não em variável de ambiente. As linhas *_TOKEN / *_KEY abaixo existem para
# documentar o que precisa existir — ver README.md §2–§4.
# -----------------------------------------------------------------------------

# --- B2C Finance API ---------------------------------------------------------
# URL base da API V1 (sem barra no final).
B2C_FINANCE_API_URL=https://b2-c-finance.vercel.app/api/v1
# Token da integração (Configurações → Integrações → Nova integração).
# → Guardar na credencial "B2C Finance API" (Header Auth), não aqui.
B2C_FINANCE_API_TOKEN=b2c_live_XXXXXXXX_COLE_NA_CREDENCIAL_DO_N8N

# --- WhatsApp (Meta WhatsApp Cloud API) --------------------------------------
# URL base da Graph API, com versão (sem barra no final).
WHATSAPP_API_URL=https://graph.facebook.com/v21.0
# Token de acesso do app (usuário do sistema). → Credencial "WhatsApp API".
WHATSAPP_API_TOKEN=COLE_NA_CREDENCIAL_DO_N8N
# App Secret do app na Meta — valida a assinatura X-Hub-Signature-256.
WHATSAPP_WEBHOOK_SECRET=COLE_O_APP_SECRET_AQUI
# Texto livre que você define e repete no painel da Meta (verificação do webhook).
WHATSAPP_VERIFY_TOKEN=defina-um-texto-aleatorio-longo
# Id do número de telefone na Meta (fallback se o payload não trouxer).
WHATSAPP_PHONE_NUMBER_ID=000000000000000
# Diretório de quem pode conversar com o agente: número (E.164 sem +) → nome
# e perfil. Perfis: admin, financeiro, comercial, leitura
# (schemas/user-profiles.json). Número fora daqui recebe só uma resposta
# genérica — nenhum dado. JSON em UMA linha.
B2C_WHATSAPP_USERS={"5571999990000":{"name":"Raiane","profile":"financeiro"},"5571988880000":{"name":"Bianca","profile":"comercial"}}

# --- Relatórios diários por WhatsApp (daily-*-report.json) -------------------
# Quem recebe (E.164 sem +, separados por vírgula).
B2C_REPORT_RECIPIENTS=5571999990000,5571988880000
# Horários em CRON (minuto hora dia mês dia-da-semana), no FUSO DO WORKFLOW
# (Workflow → Settings → Timezone; os JSONs vêm com America/Bahia).
# Padrões se vazio: manhã 07:00 seg–sáb; noite 19:00 seg–sex.
B2C_MORNING_REPORT_CRON=0 7 * * 1-6
B2C_EVENING_REPORT_CRON=0 19 * * 1-5
# Fuso da DATA do relatório ("hoje"). Deve ser o do negócio — é o que a API
# usa para dias e competências. Padrão: America/Bahia (UTC−3, sem horário de verão).
B2C_REPORT_TIMEZONE=America/Bahia
# Envio: "text" (mensagem livre — só entrega dentro da janela de 24 h da Meta)
# ou "template" (modelo aprovado com UMA variável {{1}} no corpo).
WHATSAPP_REPORT_MODE=text
WHATSAPP_REPORT_TEMPLATE=relatorio_diario
WHATSAPP_REPORT_TEMPLATE_LANG=pt_BR

# --- Modelo de IA --------------------------------------------------------------
# Chave do provedor do modelo. → Credencial "OpenAI" (ou a do provedor escolhido).
OPENAI_API_KEY=COLE_NA_CREDENCIAL_DO_N8N
# Alternativa equivalente (se trocar o nó do modelo): ANTHROPIC_API_KEY=...

# --- Configuração do n8n para estes workflows ---------------------------------
# Permite o módulo crypto no nó Code (validação HMAC da assinatura).
NODE_FUNCTION_ALLOW_BUILTIN=crypto
# Permite ler $env.* nas expressões (URL base, lista de números, segredos do webhook).
N8N_BLOCK_ENV_ACCESS_IN_NODE=false
