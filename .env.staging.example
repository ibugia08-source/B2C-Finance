# =====================================================================
# B2C FINANCE — STAGING (03 §4.6: produção e staging com bancos separados)
#
# Banco próprio, dados migrados/anonimizados. É onde os GATES de fase
# (cenários S1-S27) são validados antes de abrir a fase seguinte.
# Copie para .env quando for trabalhar em staging.
# =====================================================================

APP_ENV="staging"

# Instância local, banco SEPARADO do de desenvolvimento:
POSTGRES_PRISMA_URL="postgres://b2cdev:b2cdev@127.0.0.1:55432/b2c_finance_staging"
POSTGRES_URL_NON_POOLING="postgres://b2cdev:b2cdev@127.0.0.1:55432/b2c_finance_staging"

# Staging hospedado (Supabase próprio, quando existir): a URL precisa conter
# "staging" no host ou no nome do banco — é assim que scripts/guard.ts
# reconhece o ambiente e recusa confundi-lo com produção.

SESSION_SECRET="segredo-proprio-de-staging-32+chars"

NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
B2C_STORAGE_BUCKET="b2c-finance-files-staging"
