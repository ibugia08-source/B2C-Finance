generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Supabase (criado no Storage da Vercel) injeta estas variáveis automaticamente.
  // url = conexão com pool (queries da aplicação)
  // directUrl = conexão direta (db push / migrations)
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

// ===================================================================
// WORKSPACE — dono lógico e limite de isolamento (01 §4.2).
//
// Guarda os parâmetros que o resto do sistema consulta em vez de assumir:
// fuso, moeda e locale (01 §3.4/§3.15). Enquanto houver um único workspace,
// existe exatamente uma linha; a Fase 1 liga LegalEntity e Agencia a ele.
// ===================================================================
model Workspace {
  id        String   @id @default(cuid())
  name      String
  /// Fuso de EXIBIÇÃO. Os instantes são gravados em UTC (timestamptz);
  /// competência e vencimento são lidos neste fuso.
  timezone  String   @default("America/Bahia")
  locale    String   @default("pt-BR")
  currency  String   @default("BRL")
  /// Dono da conta (User do v1 que já funciona como limite de isolamento).
  ownerId   String?  @unique
  owner     User?    @relation("OwnerWorkspace", fields: [ownerId], references: [id])
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  legalEntities  LegalEntity[]
  accounts       AccountingAccount[]
  metrics        MetricDefinition[]
  postingRules   PostingRule[]
  ledger         LedgerTransaction[]
  featureFlags   FeatureFlag[]
  outbox         OutboxEvent[]
  agencies       Agency[]
  economicGroups EconomicGroup[]
}

// ===================================================================
// ENTIDADE LEGAL × AGÊNCIA (01 §4.2)
//
// EntidadeLegal é o CNPJ: dona da emissão fiscal, das contas bancárias, dos
// passivos fiscais e do calendário tributário — é por ela que sai a
// exportação do contador. Agência é a unidade de NEGÓCIO (dimensão
// gerencial); várias agências podem dividir a mesma EntidadeLegal.
//
// Padrão de setup: 1 EntidadeLegal = 1 Agência espelhadas, até o
// administrador separar. A B2C Gestão nasce assim.
// ===================================================================
model LegalEntity {
  id            String    @id @default(cuid())
  workspaceId   String
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  /// Razão social.
  legalName     String
  /// Nome fantasia (o que aparece na interface).
  tradeName     String?
  /// Só dígitos, sem máscara. Único por workspace quando informado.
  cnpj          String?
  /// SIMPLES_NACIONAL | LUCRO_PRESUMIDO | LUCRO_REAL | MEI | OUTRO
  taxRegime     String?
  /// Inscrições estadual/municipal e afins: { estadual, municipal, ... }
  registrations Json?
  timezone      String    @default("America/Bahia")
  currency      String    @default("BRL")
  /// Parâmetros fiscais (alíquotas, regras de provisão) — 01 §3.8.
  taxSettings   Json?
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(3)

  agencies Agency[]

  @@unique([workspaceId, cnpj])
  @@index([workspaceId])
  @@index([active])
}

model Agency {
  id            String      @id @default(cuid())
  workspaceId   String
  workspace     Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  /// A qual CNPJ esta unidade de negócio pertence (várias podem compartilhar).
  legalEntityId String
  legalEntity   LegalEntity @relation(fields: [legalEntityId], references: [id])
  name          String
  /// Identificador curto e estável para URL e importação (ex.: "b2c-gestao").
  slug          String
  /// Cor de identificação nos painéis (hex, ex.: "#1E70D3").
  color         String?
  active        Boolean     @default(true)
  createdAt     DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime    @updatedAt @db.Timestamptz(3)

  relationships ClientAgencyRelationship[]
  /// Usuários cujo recorte de dados é esta agência (03 §1.1).
  scopedUsers   User[]                     @relation("ScopedUsers")

  @@unique([workspaceId, slug])
  @@index([workspaceId])
  @@index([legalEntityId])
  @@index([active])
}

// Agregador ANALÍTICO de clientes relacionados (receita, LTV, inadimplência
// e exposição consolidadas). Não substitui Client: um grupo econômico reúne
// clientes que continuam distintos (01 §4.2).
model EconomicGroup {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  notes       String?
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)

  @@unique([workspaceId, name])
  @@index([workspaceId])
}

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  // Papel/função na equipe. String (não enum) de propósito: novos papéis não
  // exigem migration. Valores: ADMIN | GESTOR | FINANCEIRO | ADMINISTRATIVO |
  // COMERCIAL | COBRANCA | USER (legado). Catálogo em src/lib/permissions.ts.
  role         String    @default("USER")
  active       Boolean   @default(true)
  // Proteção contra força bruta no login: contador de falhas seguidas e
  // bloqueio temporário (ver loginAction em lib/actions/auth.ts).
  failedLogins Int       @default(0)
  lockedUntil  DateTime? @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @db.Timestamptz(3)

  person Person?

  // ===== Equipe (workspace): membro enxerga os dados do dono da conta =====
  // null → o próprio usuário é o dono do workspace (comportamento atual).
  workspaceOwnerId String?
  workspaceOwner   User?   @relation("WorkspaceMembers", fields: [workspaceOwnerId], references: [id], onDelete: SetNull)
  workspaceMembers User[]  @relation("WorkspaceMembers")

  // Ajustes finos de permissão por usuário (diferenças vs. o padrão do papel).
  permissions UserPermission[]

  // ===== Recorte de dados (03 §1.1) =====
  // DECIDIDO 19.11 (31/08): só DOIS recortes existem — a carteira inteira do
  // workspace, ou UMA agência. O escopo "meus clientes" da spec caiu porque
  // depende de ligar o usuário do login à pessoa da folha, e a direção decidiu
  // que esse vínculo NÃO existe. Sem ele, "meus" só poderia ser adivinhado por
  // nome, que é exatamente o tipo de regra inventada que o plano proíbe.
  // A agência é a unidade certa para isso: ela existe justamente para dizer
  // quais clientes são de quem (19.15).
  dataScope     String  @default("WORKSPACE") /// WORKSPACE | AGENCY
  scopeAgencyId String?
  scopeAgency   Agency? @relation("ScopedUsers", fields: [scopeAgencyId], references: [id], onDelete: SetNull)

  // ===== Multiusuário: dados privados de cada conta (owner) =====
  workspace          Workspace?           @relation("OwnerWorkspace")
  ownedLedgerTx      LedgerTransaction[]  @relation("OwnerLedgerTransaction")
  ownedAccounts      Account[]            @relation("OwnerAccount")
  ownedCards         CreditCard[]         @relation("OwnerCreditCard")
  ownedAccountCards  AccountCard[]        @relation("OwnerAccountCard")
  ownedTransactions  Transaction[]        @relation("OwnerTransaction")
  ownedInvoices      CreditCardInvoice[]  @relation("OwnerInvoice")
  ownedImportBatches ImportBatch[]        @relation("OwnerImportBatch")
  ownedIncomes       Income[]             @relation("OwnerIncome")
  ownedCashBoxes     CashBox[]            @relation("OwnerCashBox")
  ownedPeople        Person[]             @relation("OwnerPerson")
  ownedReceivables   Receivable[]         @relation("OwnerReceivable")
  ownedPayments      PersonPayment[]      @relation("OwnerPersonPayment")
  ownedRules         CategorizationRule[] @relation("OwnerRule")
  ownedInstallments  Installment[]        @relation("OwnerInstallment")
  ownedCashMovements CashBoxMovement[]    @relation("OwnerCashMovement")
  ownedConversations AIConversation[]     @relation("OwnerAIConversation")
  ownedMemories      AIMemory[]           @relation("OwnerAIMemory")
  ownedClients       Client[]             @relation("OwnerClient")

  // ===== ERP de agência (fundação) =====
  ownedClientContacts      ClientContact[]     @relation("OwnerClientContact")
  ownedServices            Service[]           @relation("OwnerService")
  ownedContracts           Contract[]          @relation("OwnerContract")
  ownedContractServices    ContractService[]   @relation("OwnerContractService")
  ownedBillings            Billing[]           @relation("OwnerBilling")
  ownedBillingPayments     Payment[]           @relation("OwnerPayment")
  ownedEmployees           Employee[]          @relation("OwnerEmployee")
  ownedPayrolls            Payroll[]           @relation("OwnerPayroll")
  ownedPayrollItems        PayrollItem[]       @relation("OwnerPayrollItem")
  ownedCommissions         Commission[]        @relation("OwnerCommission")
  ownedAssets              Asset[]             @relation("OwnerAsset")
  ownedLiabilities         Liability[]         @relation("OwnerLiability")
  ownedLoans               Loan[]              @relation("OwnerLoan")
  ownedImportTemplates     ImportTemplate[]    @relation("OwnerImportTemplate")
  ownedExportReports       ExportReport[]      @relation("OwnerExportReport")
  ownedCollectionHistories CollectionHistory[] @relation("OwnerCollectionHistory")
  ownedFinancialAlerts     FinancialAlert[]    @relation("OwnerFinancialAlert")
  ownedSavedViews          SavedView[]         @relation("OwnerSavedView")
  ownedAnnualTargets       AnnualTarget[]      @relation("OwnerAnnualTarget")

  // ===== Contratos documentais (modelos DOCX) e dossiê do cliente =====
  ownedContractTemplates  ContractTemplate[]  @relation("OwnerContractTemplate")
  ownedGeneratedContracts GeneratedContract[] @relation("OwnerGeneratedContract")
  ownedClientDocuments    ClientDocument[]    @relation("OwnerClientDocument")
  ownedClientNotes        ClientNote[]        @relation("OwnerClientNote")

  // ===== Perdas de clientes, Ofertas (Planos), Upsell e Receita Extra =====
  ownedClientLosses             ClientLoss[]               @relation("OwnerClientLoss")
  ownedOffers                   Offer[]                    @relation("OwnerOffer")
  ownedOfferServices            OfferService[]             @relation("OwnerOfferService")
  ownedUpsells                  Upsell[]                   @relation("OwnerUpsell")
  ownedUpsellServices           UpsellService[]            @relation("OwnerUpsellService")
  ownedExtraRevenues            ExtraRevenue[]             @relation("OwnerExtraRevenue")
  ownedRoutineItemStates        RoutineItemState[]         @relation("OwnerRoutineItemState")
  ownedClientMonthDelinquencies ClientMonthDelinquency[]   @relation("OwnerClientMonthDelinquency")
  ownedClientRenewals           ClientRenewal[]            @relation("OwnerClientRenewal")
  // F1.1 — escopo por dono nas entidades novas.
  ownedRelationships            ClientAgencyRelationship[] @relation("OwnerClientRelationship")
  ownedAvaliacoes               AvaliacaoMensal[]          @relation("OwnerAvaliacaoMensal")
  ownedOnboarding               OnboardingTask[]           @relation("OwnerOnboardingTask")
  ownedTerms                    CommercialTerm[]           @relation("OwnerCommercialTerm")
  ownedAssignments              ClientManagerAssignment[]  @relation("OwnerManagerAssignment")
  ownedApplications             PaymentApplication[]       @relation("OwnerPaymentApplication")
  ownedCredits                  CustomerCredit[]           @relation("OwnerCustomerCredit")
  ownedCreditMoves              CustomerCreditMovement[]   @relation("OwnerCreditMovement")
}

// Diferenças de permissão de UM usuário vs. o padrão do papel dele.
// enabled=true → concede além do papel; enabled=false → revoga algo do papel.
// Só as DIFERENÇAS são gravadas (restaurar padrão = apagar as linhas).
// Modelo GLOBAL (sem ownerId): gerenciado apenas por quem tem
// usuarios.alterar_permissoes. Catálogo de ids em src/lib/permissions.ts.
model UserPermission {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission String
  enabled    Boolean  @default(true)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  @@unique([userId, permission])
  @@index([userId])
}

model Person {
  id        String   @id @default(cuid())
  name      String
  type      String   @default("pessoal") // pessoal | empresa | terceiro | familiar
  notes     String?
  userId    String?  @unique
  user      User?    @relation(fields: [userId], references: [id])
  // Dono do registro (conta multiusuário). O nome é único POR dono, não global.
  ownerId   String?
  owner     User?    @relation("OwnerPerson", fields: [ownerId], references: [id])
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  cards        CreditCard[]    @relation("CardHolder")
  transactions Transaction[]   @relation("ResponsiblePerson")
  paid         Transaction[]   @relation("PayerPerson")
  receivables  Receivable[]
  incomes      Income[]
  payments     PersonPayment[]
  employees    Employee[]

  @@unique([ownerId, name])
  @@index([ownerId])
}

model Account {
  id        String   @id @default(cuid())
  name      String
  bank      String?
  type      String   @default("corrente") // corrente | poupanca | dinheiro | investimento
  balance   Decimal  @default(0) @db.Decimal(14, 2)
  active    Boolean  @default(true)
  ownerId   String?
  owner     User?    @relation("OwnerAccount", fields: [ownerId], references: [id])
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  transactions    Transaction[]
  incomes         Income[]
  cashBoxes       CashBox[]
  cards           CreditCard[]
  personPayments  PersonPayment[]
  billingPayments Payment[]

  @@index([ownerId])
}

model CreditCard {
  id         String   @id @default(cuid())
  name       String
  bank       String?
  type       String   @default("pessoal") // pessoal | empresarial | terceiro
  holderId   String?
  holder     Person?  @relation("CardHolder", fields: [holderId], references: [id])
  accountId  String?
  account    Account? @relation(fields: [accountId], references: [id])
  limitTotal Decimal  @default(0) @db.Decimal(14, 2)
  closingDay Int      @default(1)
  dueDay     Int      @default(10)
  active     Boolean  @default(true)
  ownerId    String?
  owner      User?    @relation("OwnerCreditCard", fields: [ownerId], references: [id])
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  transactions Transaction[]
  invoices     CreditCardInvoice[]
  accountCards AccountCard[]

  @@index([ownerId])
}

// Cartão (físico ou virtual) que pertence a uma conta bancária (CreditCard).
// Todos os gastos dos cartões compõem a fatura da conta.
model AccountCard {
  id         String     @id @default(cuid())
  name       String
  cardId     String
  card       CreditCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  kind       String     @default("fisico") // fisico | virtual
  lastDigits String? // últimos 4 dígitos
  limit      Decimal    @default(0) @db.Decimal(14, 2) // limite individual
  notes      String?
  ownerId    String?
  owner      User?      @relation("OwnerAccountCard", fields: [ownerId], references: [id])
  createdAt  DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime   @updatedAt @db.Timestamptz(3)

  transactions Transaction[]

  @@index([ownerId])
}

// ===================================================================
// PLANO DE CONTAS GERENCIAL-CONTÁBIL (03 §2.2)
//
// A interface continua falando em grupos amigáveis; o motor precisa da
// NATUREZA de cada conta. É isso que impede empréstimo, fatura de cartão e
// transferência de virarem despesa duplicada — e é o que faz a DRE somar só
// o que é resultado (statementType = PNL).
//
// Category (v1) continua existindo e ganha o vínculo `accountId`: cada
// categoria da interface aponta para a conta contábil correspondente. As
// telas seguem usando Category; o AccountingEngine usa a conta.
// ===================================================================

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum NormalBalance {
  DEBIT
  CREDIT
}

enum StatementType {
  /// Balanço patrimonial — NÃO entra na DRE.
  BALANCE_SHEET
  /// Resultado (DRE).
  PNL
}

model AccountingAccount {
  id          String              @id @default(cuid())
  workspaceId String
  workspace   Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  /// Código hierárquico: "4", "4.1", "4.1.01".
  code        String
  name        String
  /// Grupo raiz para agrupamento amigável na interface.
  group       String
  parentId    String?
  parent      AccountingAccount?  @relation("AccountTree", fields: [parentId], references: [id])
  children    AccountingAccount[] @relation("AccountTree")

  accountType      AccountType
  normalBalance    NormalBalance
  statementType    StatementType
  /// Só contas FOLHA recebem lançamento; as sintéticas apenas agregam.
  isPostingAccount Boolean       @default(true)

  /// Conta temporária de migração/importação (03 §2.2): gera alerta, tem
  /// limite máximo no fechamento e não pode ser destino permanente de regra.
  isUnclassified Boolean  @default(false)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  categories  Category[]
  LedgerEntry LedgerEntry[]

  @@unique([workspaceId, code])
  @@index([workspaceId])
  @@index([workspaceId, statementType])
  @@index([workspaceId, accountType])
  @@index([active])
}

// ===================================================================
// REGISTRY DE MÉTRICAS (01 §7; 03 §4.1)
//
// Métrica é CONTRATO VERSIONADO: fórmula, fontes, grão, base temporal,
// arredondamento e política de nulo ficam registrados aqui, com versão. O
// código implementa; o registry documenta e versiona.
//
// Por que importa: quando a fórmula do CAC mudar em 2027, nasce a versão 2 —
// e o snapshot de 2026 continua reportando a versão 1, sem reescrever o
// passado (01 §2.21-2.22, cenário S22).
// ===================================================================

enum MetricGrain {
  /// Um valor por competência (mês).
  COMPETENCE
  /// Um valor por período livre (intervalo de datas).
  PERIOD
  /// Estado atual, sem recorte temporal (ex.: caixa hoje).
  POINT_IN_TIME
  /// Um valor por cliente/relação.
  CLIENT
}

enum MetricDateBasis {
  /// Lê a competência (resultado/DRE).
  COMPETENCE
  /// Lê a data de caixa (entrada/saída de dinheiro).
  CASH
  /// Lê o estado atual das tabelas vivas.
  CURRENT_STATE
  /// Lê a fotografia do fechamento.
  SNAPSHOT
}

model MetricDefinition {
  id                 String          @id @default(cuid())
  workspaceId        String?
  workspace          Workspace?      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  /// Chave estável consumida pelo código (ex.: "faturamento_total").
  key                String
  name               String
  description        String
  /// Fórmula em português, como aparece no tooltip da interface.
  formulaDescription String
  grain              MetricGrain
  dateBasis          MetricDateBasis
  /// Entidades de origem, para rastrear o impacto de uma mudança de schema.
  sourceEntities     String[]
  /// Filtros implícitos da métrica (ex.: "status != CANCELED").
  filters            String?
  /// Política de arredondamento (01 §3.14).
  rounding           String          @default("half-up 2 casas")
  /// O que fazer quando o denominador é zero ou não há dado.
  nullPolicy         String          @default("denominador zero → null (exibe —)")
  version            Int             @default(1)
  effectiveFrom      DateTime        @default(now()) @db.Timestamptz(3)
  effectiveTo        DateTime?       @db.Timestamptz(3)
  createdAt          DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime        @updatedAt @db.Timestamptz(3)

  @@unique([workspaceId, key, version])
  @@index([workspaceId])
  @@index([key])
}

// ===================================================================
// RAZÃO (LEDGER) E REGRAS DE LANÇAMENTO (01 §3.10-3.11, §4.9)
//
// Nenhuma tela escreve aqui. O domínio publica um FATO; o AccountingEngine
// aplica a PostingRule ativa e versionada e grava a partida dobrada.
//
// Invariantes:
//  - débitos = créditos em toda transação;
//  - um lançamento tem UM lado (ou débito, ou crédito), nunca os dois;
//  - transação postada não é editada nem apagada: corrige-se por REVERSAL
//    (evento compensatório), preservando a história (01 §2.8).
// ===================================================================

model PostingRule {
  id                String    @id @default(cuid())
  workspaceId       String
  workspace         Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  /// Evento de domínio (ex.: "REVENUE_RECOGNIZED"). Ver 01 §3.10.
  eventType         String
  version           Int       @default(1)
  name              String
  description       String
  /// Códigos de conta do plano (03 §2.2). "Banco/Caixa" e afins são
  /// resolvidos em tempo de execução a partir do contexto do fato.
  debitAccountCode  String
  creditAccountCode String
  /// A operação reconhece resultado (entra na DRE) ou só move ativo/passivo?
  affectsPnl        Boolean
  active            Boolean   @default(true)
  effectiveFrom     DateTime  @default(now()) @db.Timestamptz(3)
  effectiveTo       DateTime? @db.Timestamptz(3)
  createdAt         DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @db.Timestamptz(3)

  @@unique([workspaceId, eventType, version])
  @@index([workspaceId, eventType, active])
}

model LedgerTransaction {
  id                 String             @id @default(cuid())
  workspaceId        String
  workspace          Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  eventType          String
  /// Fato de origem: "Billing", "Payment", "Transaction"...
  sourceType         String
  sourceId           String
  /// Competência do RESULTADO (YYYY-MM). Caixa tem data própria em postedAt.
  competence         String
  postedAt           DateTime           @default(now()) @db.Timestamptz(3)
  /// Preenchido quando esta transação NEUTRALIZA outra (01 §3.10 "Reversal").
  reversalOfId       String?            @unique
  reversalOf         LedgerTransaction? @relation("Reversal", fields: [reversalOfId], references: [id])
  reversedBy         LedgerTransaction? @relation("Reversal")
  postingRuleVersion Int
  /// Chave que impede postar o mesmo fato duas vezes (01 §2.13).
  idempotencyKey     String
  ownerId            String?
  owner              User?              @relation("OwnerLedgerTransaction", fields: [ownerId], references: [id])
  createdAt          DateTime           @default(now()) @db.Timestamptz(3)

  entries LedgerEntry[]

  @@unique([workspaceId, idempotencyKey])
  @@index([workspaceId, competence])
  @@index([workspaceId, eventType])
  @@index([sourceType, sourceId])
  @@index([ownerId])
}

model LedgerEntry {
  id                  String            @id @default(cuid())
  ledgerTransactionId String
  ledgerTransaction   LedgerTransaction @relation(fields: [ledgerTransactionId], references: [id], onDelete: Cascade)
  accountId           String
  account             AccountingAccount @relation(fields: [accountId], references: [id])
  debit               Decimal           @default(0) @db.Decimal(14, 2)
  credit              Decimal           @default(0) @db.Decimal(14, 2)
  /// Dimensões gerenciais do lançamento (01 §4.9).
  agencyId            String?
  clientId            String?
  serviceId           String?
  createdAt           DateTime          @default(now()) @db.Timestamptz(3)

  @@index([ledgerTransactionId])
  @@index([accountId])
  @@index([clientId])
  @@index([agencyId])
}

// Bandeira de recurso (03 §4.6): liga módulos sensíveis sem deploy. A
// postagem no razão nasce DESLIGADA (ledger_enabled), como manda F0.8.
model FeatureFlag {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  key         String
  enabled     Boolean   @default(false)
  description String?
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)

  @@unique([workspaceId, key])
}

// ===================================================================
// TRANSACTIONAL OUTBOX (03 §4.2; 01 §2.20)
//
// Integração externa fica FORA da atomicidade financeira. O fato, o razão, a
// auditoria e o evento de saída são gravados na MESMA transação; a entrega
// (WhatsApp, CRM, e-mail, webhook) acontece depois, por um worker.
//
// Por que assim: se a entrega fosse dentro da transação, um WhatsApp fora do
// ar desfaria um pagamento já registrado. E se fosse fora, sem outbox, um
// crash entre o commit e o envio perderia a notificação em silêncio.
// ===================================================================

enum OutboxStatus {
  /// Esperando a próxima tentativa.
  PENDING
  /// Entregue com sucesso.
  DELIVERED
  /// Esgotou as tentativas — exige olhar humano (dead-letter).
  DEAD_LETTER
  /// Cancelado antes de entregar (ex.: fato revertido).
  CANCELED
}

model OutboxEvent {
  id            String       @id @default(cuid())
  workspaceId   String
  workspace     Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  /// Tipo do evento de saída (ex.: "PAYMENT_RECEIVED").
  eventType     String
  /// Destino lógico ("whatsapp", "crm", "email", "webhook").
  channel       String
  /// Fato de origem, para rastrear de volta.
  sourceType    String
  sourceId      String
  /// Conteúdo MÍNIMO da entrega (03 §4.2) — nunca dados sensíveis a mais.
  payload       Json
  status        OutboxStatus @default(PENDING)
  attempts      Int          @default(0)
  /// Quando a próxima tentativa pode ocorrer (recuo exponencial).
  nextAttemptAt DateTime     @default(now()) @db.Timestamptz(3)
  lastError     String?
  deliveredAt   DateTime?    @db.Timestamptz(3)
  /// Impede publicar o mesmo evento duas vezes (unique no banco).
  dedupeKey     String
  createdAt     DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime     @updatedAt @db.Timestamptz(3)

  @@unique([workspaceId, dedupeKey])
  @@index([status, nextAttemptAt])
  @@index([workspaceId, status])
  @@index([sourceType, sourceId])
}

model Category {
  id        String             @id @default(cuid())
  name      String             @unique
  color     String?
  kind      String             @default("despesa") // despesa | receita | mista
  /// Conta contábil correspondente (03 §2.2). A interface usa a categoria;
  /// o AccountingEngine usa a conta.
  accountId String?
  account   AccountingAccount? @relation(fields: [accountId], references: [id])
  parentId  String?
  parent    Category?          @relation("CategoryParent", fields: [parentId], references: [id])
  children  Category[]         @relation("CategoryParent")
  createdAt DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt DateTime           @updatedAt @db.Timestamptz(3)

  transactions Transaction[]
  rules        CategorizationRule[]
  incomes      Income[]
}

model Transaction {
  id            String             @id @default(cuid())
  date          DateTime           @db.Timestamptz(3)
  description   String
  amount        Decimal            @db.Decimal(14, 2) // sempre positivo; tipo define sinal
  type          String             @default("despesa") // despesa | receita | transferencia | ajuste
  origin        String             @default("cartao") // cartao | pix | debito | boleto | dinheiro
  cardId        String?
  card          CreditCard?        @relation(fields: [cardId], references: [id])
  accountId     String?
  account       Account?           @relation(fields: [accountId], references: [id])
  categoryId    String?
  category      Category?          @relation(fields: [categoryId], references: [id])
  responsibleId String?
  responsible   Person?            @relation("ResponsiblePerson", fields: [responsibleId], references: [id])
  payerId       String?
  payer         Person?            @relation("PayerPerson", fields: [payerId], references: [id])
  belongsTo     String             @default("pessoal") // pessoal | empresa | terceiro | familiar
  status        String             @default("pendente") // pendente | pago | devendo | reembolsado | cancelado
  reimbursable  Boolean            @default(false)
  dueDate       DateTime?          @db.Timestamptz(3) // vencimento (despesas manuais a vencer)
  notes         String?
  invoiceId     String?
  invoice       CreditCardInvoice? @relation(fields: [invoiceId], references: [id])
  importBatchId String?
  importBatch   ImportBatch?       @relation(fields: [importBatchId], references: [id])
  installments  Installment[]
  receivables   Receivable[]
  hash          String?            @unique

  // ===== Parcelamento como METADADO da transação (fatura real importada) =====
  // "AMAZON 3/10" → installmentNumber=3, installmentTotal=10. NÃO gera
  // parcelas/faturas futuras no banco; projeções são calculadas em memória.
  installmentNumber   Int?
  installmentTotal    Int?
  // Chave do grupo de parcelamento (mesma compra ao longo dos meses):
  // sha1(cartão + descrição normalizada + valor da parcela + total de parcelas).
  installmentGroupKey String?
  // true quando categoria/pessoa/contexto foram herdados de uma parcela
  // anterior reconhecida pelo histórico.
  historyMatched      Boolean @default(false)

  // Cartão físico/virtual dentro da conta (identificado pelo final do cartão
  // na fatura, quando possível; fallback manual).
  accountCardId String?
  accountCard   AccountCard? @relation(fields: [accountCardId], references: [id])

  // Preparação Open Finance: id do registro no sistema de origem.
  externalId String?

  // ===== ERP de agência: classificação gerencial da DESPESA =====
  // Opcionais para não afetar lançamentos pessoais existentes.
  expenseType ExpenseType? // fixa | variável | folha | ads | ...
  recurrence  RecurrenceType? // recorrência da despesa (fixas)
  clientId    String? // despesa alocada a um cliente (rentabilidade)
  client      Client?         @relation(fields: [clientId], references: [id])
  serviceId   String? // serviço vinculado (rentabilidade por serviço)
  service     Service?        @relation(fields: [serviceId], references: [id])

  // ===== Recorrência de despesa (ocorrências materializadas) =====
  // Despesa recorrente gera ocorrências futuras ligadas pelo mesmo grupo.
  // Permite editar UMA ocorrência ou TODAS, e encerrar a recorrência
  // (remove futuras não pagas). CUSTOM usa recurrenceInterval (meses).
  recurrenceGroupId  String?
  recurrenceInterval Int? // intervalo em meses quando recurrence=CUSTOM

  // ===== Despesa tipo CARTÃO: competência da fatura =====
  cardInvoiceMonth Int? // 1-12
  cardInvoiceYear  Int?

  // Dono do registro (conta multiusuário).
  ownerId String?
  owner   User?   @relation("OwnerTransaction", fields: [ownerId], references: [id])

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([date])
  @@index([cardId])
  @@index([categoryId])
  @@index([responsibleId])
  @@index([invoiceId])
  @@index([status])
  @@index([installmentGroupKey])
  @@index([accountCardId])
  @@index([clientId])
  @@index([expenseType])
  @@index([recurrenceGroupId])
  @@index([ownerId])
}

model Installment {
  id            String             @id @default(cuid())
  transactionId String
  transaction   Transaction        @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  number        Int
  total         Int
  amount        Decimal            @db.Decimal(14, 2)
  dueDate       DateTime           @db.Timestamptz(3)
  paid          Boolean            @default(false)
  invoiceId     String?
  invoice       CreditCardInvoice? @relation(fields: [invoiceId], references: [id])
  ownerId       String?
  owner         User?              @relation("OwnerInstallment", fields: [ownerId], references: [id])
  createdAt     DateTime           @default(now()) @db.Timestamptz(3)

  @@index([transactionId])
  @@index([paid, dueDate])
  @@index([invoiceId])
  @@index([ownerId])
}

model CreditCardInvoice {
  id             String     @id @default(cuid())
  cardId         String
  card           CreditCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  referenceMonth Int // 1-12
  referenceYear  Int
  closingDate    DateTime   @db.Timestamptz(3)
  dueDate        DateTime   @db.Timestamptz(3)
  total          Decimal    @default(0) @db.Decimal(14, 2)
  paid           Decimal    @default(0) @db.Decimal(14, 2)
  // Total declarado no PDF da fatura (para conferência com a soma importada).
  declaredTotal  Decimal?   @db.Decimal(14, 2)
  status         String     @default("aberta") // aberta | fechada | paga | atrasada | parcial
  // Preparação Open Finance: id da fatura no sistema de origem.
  externalId     String?
  ownerId        String?
  owner          User?      @relation("OwnerInvoice", fields: [ownerId], references: [id])
  createdAt      DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime   @updatedAt @db.Timestamptz(3)

  transactions Transaction[]
  installments Installment[]

  @@unique([cardId, referenceYear, referenceMonth])
  @@index([status])
  @@index([dueDate])
  @@index([ownerId])
}

model Receivable {
  id            String       @id @default(cuid())
  personId      String
  person        Person       @relation(fields: [personId], references: [id])
  transactionId String?
  transaction   Transaction? @relation(fields: [transactionId], references: [id])
  amount        Decimal      @db.Decimal(14, 2)
  dueDate       DateTime     @db.Timestamptz(3)
  paidAt        DateTime?    @db.Timestamptz(3)
  status        String       @default("aberto") // aberto | pago | atrasado | renegociado
  notes         String?
  ownerId       String?
  owner         User?        @relation("OwnerReceivable", fields: [ownerId], references: [id])
  createdAt     DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime     @updatedAt @db.Timestamptz(3)

  @@index([ownerId])
}

model Income {
  id          String    @id @default(cuid())
  description String    @default("")
  amount      Decimal   @db.Decimal(14, 2)
  receivedAt  DateTime  @default(now()) @db.Timestamptz(3)
  // Origem do recebimento: BANK_ACCOUNT | PIX | TRANSFER | CASH
  sourceType  String    @default("BANK_ACCOUNT")
  // Tipo: SALARY | COMPANY_WITHDRAWAL | CLIENT | REIMBURSEMENT | SALE | LOAN_RECEIVED | OTHER
  incomeType  String    @default("OTHER")
  // Status: RECEIVED | EXPECTED | LATE | CANCELED
  status      String    @default("RECEIVED")
  accountId   String?
  account     Account?  @relation(fields: [accountId], references: [id])
  personId    String?
  person      Person?   @relation(fields: [personId], references: [id])
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id])
  notes       String?
  // Compatibilidade com seed/legado
  date        DateTime? @db.Timestamptz(3)
  source      String?

  // ===== ERP de agência: classificação gerencial da RECEITA =====
  // Opcionais para não afetar receitas pessoais existentes.
  revenueType     RevenueType? // MRR | TCV | ONE_TIME | SETUP | RECOVERY | OTHER
  competenceMonth Int? // competência (reconhecimento) — 1-12
  competenceYear  Int?
  /// Competência canônica YYYY-MM (01 §3.15) — preenchida por gatilho
  /// a partir do par mês/ano acima; nunca escrever pela aplicação.
  competence      String?
  clientId        String?
  client          Client?      @relation(fields: [clientId], references: [id])
  contractId      String?
  contract        Contract?    @relation(fields: [contractId], references: [id])
  billingId       String? // cobrança que originou este recebimento (conciliação)
  billing         Billing?     @relation(fields: [billingId], references: [id])
  // Pagamento que gerou esta conciliação — a reversão apaga por ESTE id
  // (escalar de propósito, sem FK: excluir o Payment não pode cascatear).
  paymentId       String?

  ownerId   String?
  owner     User?    @relation("OwnerIncome", fields: [ownerId], references: [id])
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([receivedAt])
  @@index([status])
  @@index([clientId])
  @@index([contractId])
  @@index([billingId])
  @@index([paymentId])
  @@index([ownerId])
  @@index([competence])
  @@index([ownerId, competence])
}

model CashBox {
  id            String   @id @default(cuid())
  name          String
  currentAmount Decimal  @default(0) @db.Decimal(14, 2)
  targetAmount  Decimal? @db.Decimal(14, 2)
  // PERSONAL | EMERGENCY | INVESTMENT | COMPANY | GOAL | OTHER
  type          String   @default("PERSONAL")
  accountId     String?
  account       Account? @relation(fields: [accountId], references: [id])
  notes         String?
  ownerId       String?
  owner         User?    @relation("OwnerCashBox", fields: [ownerId], references: [id])
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)

  movements CashBoxMovement[]

  @@index([ownerId])
}

model PersonPayment {
  id        String   @id @default(cuid())
  personId  String
  person    Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  amount    Decimal  @db.Decimal(14, 2)
  paidAt    DateTime @default(now()) @db.Timestamptz(3)
  // PIX | TRANSFER | CASH | OTHER
  method    String   @default("PIX")
  accountId String?
  account   Account? @relation(fields: [accountId], references: [id])
  notes     String?
  ownerId   String?
  owner     User?    @relation("OwnerPersonPayment", fields: [ownerId], references: [id])
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([personId])
  @@index([paidAt])
  @@index([ownerId])
}

model CashBoxMovement {
  id          String   @id @default(cuid())
  cashBoxId   String
  cashBox     CashBox  @relation(fields: [cashBoxId], references: [id], onDelete: Cascade)
  // IN | OUT
  type        String
  amount      Decimal  @db.Decimal(14, 2)
  date        DateTime @default(now()) @db.Timestamptz(3)
  description String?
  ownerId     String?
  owner       User?    @relation("OwnerCashMovement", fields: [ownerId], references: [id])
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  @@index([cashBoxId])
  @@index([date])
  @@index([ownerId])
}

// Estado dos itens da ROTINA DIÁRIA por dia: itens removidos da rotina do dia
// ("removed" — só oculta da lista operacional; NÃO altera cliente/cobrança/
// despesa) e ações do checklist concluídas ("done"). Histórico auditável.
model RoutineItemState {
  id          String   @id @default(cuid())
  routineDate DateTime @db.Timestamptz(3) // dia da rotina (meia-noite local)
  itemType    String // "cobranca" | "pagamento" | "acao"
  itemKey     String // clientId | transactionId | chave estável da ação
  status      String // "removed" | "done"
  reason      String? // motivo opcional da remoção
  actorName   String? // quem executou a ação
  ownerId     String?
  owner       User?    @relation("OwnerRoutineItemState", fields: [ownerId], references: [id])
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  @@index([routineDate, itemType, itemKey])
  @@index([ownerId])
}

model ImportBatch {
  id             String   @id @default(cuid())
  source         String // csv | xlsx | pdf
  // Módulo da importação em massa (clientes | contratos | ... ); null = fatura de cartão (legado).
  module         String?
  errors         Int      @default(0)
  fileName       String?
  cardId         String?
  accountId      String?
  // Fatura âncora desta importação (quando importado para um cartão/conta).
  invoiceId      String?
  referenceMonth Int?
  referenceYear  Int?
  total          Int      @default(0)
  imported       Int      @default(0)
  duplicates     Int      @default(0)
  ownerId        String?
  owner          User?    @relation("OwnerImportBatch", fields: [ownerId], references: [id])
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  transactions Transaction[]

  @@index([ownerId])
}

model CategorizationRule {
  id       String  @id @default(cuid())
  name     String
  priority Int     @default(100)
  active   Boolean @default(true)

  // condições
  descriptionContains String?
  cardId              String?
  amountGreaterThan   Decimal? @db.Decimal(14, 2)
  amountLessThan      Decimal? @db.Decimal(14, 2)

  // ações
  categoryId      String?
  category        Category? @relation(fields: [categoryId], references: [id])
  responsibleName String?
  belongsTo       String?
  reimbursable    Boolean?
  status          String?

  ownerId String?
  owner   User?   @relation("OwnerRule", fields: [ownerId], references: [id])

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([ownerId])
}

// ===== Assistente de IA (co-piloto financeiro) =====

model AISetting {
  id          String   @id @default("default") // linha única (singleton)
  provider    String   @default("openai") // openai | anthropic | custom
  baseUrl     String? // p/ compatível-OpenAI (OpenRouter, Groq, local…)
  apiKey      String?
  model       String   @default("gpt-4o-mini")
  temperature Float    @default(0.3)
  enabled     Boolean  @default(false)
  updatedAt   DateTime @default(now()) @updatedAt @db.Timestamptz(3)
}

model AIConversation {
  id        String      @id @default(cuid())
  title     String?
  messages  AIMessage[]
  // Dono da conversa (conta multiusuário). Cada usuário só vê o próprio histórico.
  ownerId   String?
  owner     User?       @relation("OwnerAIConversation", fields: [ownerId], references: [id])
  createdAt DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt DateTime    @updatedAt @db.Timestamptz(3)

  @@index([ownerId])
}

model AIMessage {
  id               String         @id @default(cuid())
  conversationId   String
  conversation     AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role             String // user | assistant
  content          String
  promptTokens     Int?
  completionTokens Int?
  createdAt        DateTime       @default(now()) @db.Timestamptz(3)

  @@index([conversationId])
}

model AIMemory {
  id        String   @id @default(cuid())
  kind      String   @default("note") // fact | pattern | preference | alert | note
  content   String
  source    String   @default("manual") // auto | manual
  pinned    Boolean  @default(false)
  // Dono da memória (conta multiusuário). Cada usuário tem a própria base.
  ownerId   String?
  owner     User?    @relation("OwnerAIMemory", fields: [ownerId], references: [id])
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([ownerId])
}

// ===================================================================
// B2C — Módulo de Agência (Etapa 1: Clientes)
// Cliente é a raiz da espinha comercial: Cliente → Contrato → Cobrança
// → Pagamento → Receita → Despesa → Resultado. Valores monetários usam
// Decimal (precisão contábil). Gerenciado por ADMIN (dados da agência).
// ===================================================================

enum ClientStatus {
  LEAD // prospecção / negociação (legado — preferir PROSPECT)
  PROSPECT // prospecção / negociação
  ACTIVE // cliente ativo
  INACTIVE // inativo (sem relação vigente)
  PAUSED // relação pausada
  RENEWAL // em renovação
  DELINQUENT // inadimplente
  CHURNED // perdido / cancelado
}

// Modalidade de faturamento do cliente (fonte da verdade no cadastro).
// MRR = recorrente mensal; TCV = valor total pago na adesão/renovação.
enum ClientModality {
  MRR
  TCV
}

// Inadimplência do mês (rótulo simples da linha e do override manual).
enum DelinquencyStatus {
  PAGO
  DEVENDO
}

// Modalidade de uma Oferta (Plano): recorrente, valor fechado ou personalizado.
enum OfferModality {
  MRR
  TCV
  CUSTOM
}

// Status de uma oportunidade de Upsell (venda interna para a base).
enum UpsellStatus {
  OPPORTUNITY // oportunidade identificada
  NEGOTIATION // em negociação
  WON // vendido
  LOST // perdido
  PAUSED // pausado
}

model Client {
  id                  String          @id @default(cuid())
  name                String // nome fantasia / como o cliente é chamado
  legalName           String? // razão social
  document            String? // CNPJ / CPF
  email               String?
  phone               String?
  segment             String? // segmento / nicho de atuação
  city                String?
  state               String? // UF
  // Dados usados nos contratos gerados (pré-preenchimento de variáveis)
  address             String? // endereço completo do contratante
  legalRepresentative String? // nome do representante legal
  origin              String? // origem comercial: indicação | tráfego | orgânico | ...
  salesOwner          String? // responsável comercial (texto; sincronizado a partir de salesOwnerEmployee.name no save)
  // Vínculo real com o colaborador (fonte da verdade do responsável comercial).
  salesOwnerId        String?
  salesOwnerEmployee  Employee?       @relation("ClientSalesOwner", fields: [salesOwnerId], references: [id], onDelete: SetNull)
  opsOwner            String? // responsável operacional
  paymentDay          Int? // dia recorrente de pagamento MRR (1-31; ajustado ao último dia do mês quando o mês tem menos dias)
  tags                String[]        @default([])
  status              ClientStatus    @default(ACTIVE)
  // Modalidade de faturamento (MRR/TCV) — editável na linha, alimenta filtros,
  // dashboard e relatórios. Independente dos contratos (que guardam valores).
  modality            ClientModality?
  // Mês de renovação (1-12) — editável na linha; alimenta KPIs de renovação.
  renewalMonth        Int?
  // Valor mensal recorrente — usado SOMENTE em MRR (base da mensalidade).
  /// CACHE do valor atual (01 §4.4). A fonte temporal é CommercialTerm:
  /// métrica histórica NUNCA lê este campo, porque reajuste o sobrescreve
  /// e o passado se perde. Para "quanto valia em março?" use termAt().
  monthlyValue        Decimal?        @db.Decimal(14, 2)
  // Valor TOTAL do contrato — usado SOMENTE em TCV. Referência editável no
  // nível do cliente; espelha Contract.totalValue da venda/renovação.
  totalContractValue  Decimal?        @db.Decimal(14, 2)
  // Prazo do contrato em meses — editável inline em Recebimentos/Carteira.
  contractMonths      Int?
  startedAt           DateTime?       @db.Timestamptz(3) // início da relação comercial
  churnedAt           DateTime?       @db.Timestamptz(3) // data de saída (preenchida quando CHURNED)
  notes               String?

  // ===== Inadimplência do mês: override MANUAL sobre o cálculo automático =====
  // O status Pago/Devendo é calculado a partir das cobranças do mês (Billing).
  // Quando o gestor ajusta na linha, guardamos o valor + competência (mês/ano)
  // + quando e quem alterou. O override só vale para a competência gravada;
  // meses seguintes voltam a usar o cálculo automático.
  delinquencyOverride      DelinquencyStatus? // null = usar cálculo automático
  delinquencyOverrideMonth Int? // competência do override (1-12)
  delinquencyOverrideYear  Int?
  delinquencyOverrideAt    DateTime?          @db.Timestamptz(3) // data/hora do ajuste manual
  delinquencyOverrideBy    String? // nome do usuário que ajustou

  // ===== Soft Delete (Fase 0 - Reorganização) =====
  archivedAt DateTime? @db.Timestamptz(3) // soft delete: null = ativo, preenchido = arquivado
  deletedAt  DateTime? @db.Timestamptz(3) // hard delete timestamp (para auditoria)

  // Dono do registro (conta multiusuário / agência).
  ownerId String?
  owner   User?   @relation("OwnerClient", fields: [ownerId], references: [id])

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  // ===== ERP: espinha comercial =====
  contacts         ClientContact[]
  contracts        Contract[]
  billings         Billing[]
  commissions      Commission[]
  collectionEvents CollectionHistory[]
  incomes          Income[]
  expenses         Transaction[]

  // ===== Dossiê documental =====
  generatedContracts GeneratedContract[]
  contractFormLinks  ContractFormLink[]
  documents          ClientDocument[]
  contextNotes       ClientNote[]

  // ===== Perdas (histórico de churn), Upsell e Receita Extra =====
  losses        ClientLoss[]
  upsells       Upsell[]
  extraRevenues ExtraRevenue[]

  // Inadimplência manual por competência (histórico mês a mês)
  monthDelinquencies ClientMonthDelinquency[]

  // Histórico de renovações de contrato (um registro por "Sim, renovou")
  renewals      ClientRenewal[]
  relationships ClientAgencyRelationship[]
  credits       CustomerCredit[]

  @@index([ownerId])
  @@index([status])
  @@index([modality])
  @@index([renewalMonth])
  @@index([salesOwnerId])
}

// Override MANUAL de inadimplência POR COMPETÊNCIA (mês/ano) — histórico
// completo: o gestor pode gerenciar qualquer mês (seletor no módulo Clientes)
// e o ajuste fica gravado naquele mês, sem apagar os ajustes de outros meses.
// Substitui os campos delinquencyOverride* do Client (legados, backfillados).
model ClientMonthDelinquency {
  id         String            @id @default(cuid())
  clientId   String
  client     Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  month      Int // 1-12 (competência)
  year       Int
  /// Competência canônica YYYY-MM (01 §3.15) — preenchida por gatilho
  /// a partir do par mês/ano acima; nunca escrever pela aplicação.
  competence String?
  status     DelinquencyStatus // PAGO | DEVENDO
  setBy      String? // quem ajustou
  setAt      DateTime          @default(now()) @db.Timestamptz(3)
  ownerId    String?
  owner      User?             @relation("OwnerClientMonthDelinquency", fields: [ownerId], references: [id])

  @@index([year, month])
  @@index([clientId, year, month])
  @@index([ownerId])
  @@index([competence])
  @@index([ownerId, competence])
}

// Registro de RENOVAÇÃO de cliente — histórico auditável de cada "Sim,
// renovou" (Gestão do Mês / módulo Renovações). Guarda o snapshot do novo
// ciclo (prazo, valor, forma de pagamento), a decisão de lançamento nos
// recebimentos (competência escolhida + cobrança criada) e, para MRR, se o
// cliente permaneceu na lista de recebimentos mensais.
model ClientRenewal {
  id              String          @id @default(cuid())
  clientId        String
  client          Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  contractId      String? // contrato estendido (null = renovação só pelo cadastro)
  renewedAt       DateTime        @default(now()) @db.Timestamptz(3)
  months          Int // prazo do novo ciclo
  totalValue      Decimal         @db.Decimal(14, 2) // valor do novo ciclo
  monthlyValue    Decimal?        @db.Decimal(14, 2) // mensal resultante (MRR)
  modality        ClientModality? // snapshot da modalidade na renovação
  paymentMethod   String? // pix | boleto | cartão | transferência | outro
  paymentMode     String? // à vista | parcelado | mensal
  previousEndDate DateTime?       @db.Timestamptz(3) // fim de vigência antes da renovação
  newEndDate      DateTime?       @db.Timestamptz(3) // novo fim de vigência
  billingId       String? // cobrança lançada nos recebimentos (se houver)
  billingMonth    Int? // competência escolhida para o lançamento (1-12)
  billingYear     Int?
  keptMonthly     Boolean? // MRR: manteve o cliente nos recebimentos mensais?
  paymentStatus   String? // aberto | pago_total | pago_parcial
  notes           String?
  createdBy       String? // e-mail de quem registrou
  ownerId         String?
  owner           User?           @relation("OwnerClientRenewal", fields: [ownerId], references: [id])
  createdAt       DateTime        @default(now()) @db.Timestamptz(3)

  @@index([clientId])
  @@index([renewedAt])
  @@index([billingYear, billingMonth])
  @@index([ownerId])
}

// Registro de PERDA de cliente (churn). Criado automaticamente quando o
// status muda para CHURNED — guarda o snapshot da receita perdida no momento
// da perda (MRR: valor mensal; TCV: valor de referência da última adesão),
// modalidade, responsável e motivo. Histórico: um cliente pode ter várias
// perdas (saiu, voltou, saiu de novo).
model ClientLoss {
  id             String                    @id @default(cuid())
  clientId       String
  client         Client                    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  lostAt         DateTime                  @default(now()) @db.Timestamptz(3)
  modality       ClientModality? // snapshot da modalidade na perda
  monthlyValue   Decimal?                  @db.Decimal(14, 2) // MRR mensal perdido
  referenceValue Decimal?                  @db.Decimal(14, 2) // TCV de referência (última adesão)
  reason         String? // motivo da perda (opcional)
  salesOwner     String? // snapshot do responsável na perda
  // 01 §4.3: "ClientLoss pertence à relação". Nulo só no legado
  // anterior ao backfill da F1.1.
  relationshipId String?
  relationship   ClientAgencyRelationship? @relation(fields: [relationshipId], references: [id], onDelete: SetNull)
  ownerId        String?
  owner          User?                     @relation("OwnerClientLoss", fields: [ownerId], references: [id])
  createdAt      DateTime                  @default(now()) @db.Timestamptz(3)

  @@index([clientId])
  @@index([relationshipId])
  @@index([lostAt])
  @@index([ownerId])
}

// ===================================================================
// B2C ERP — Fundação do banco (comercial, cobrança, custos, folha,
// patrimônio e plataforma). Regras: ownerId em todo modelo privado,
// Decimal(14,2) para dinheiro, enums para status, índices em datas/
// status/FKs. Reuso: Account=conta bancária, CreditCardInvoice=fatura
// de cartão, CashBox=caixa, Goal=meta, Category=categoria financeira,
// ImportBatch=lote de importação. Income=receita RECEBIDA (caixa);
// Billing=cobrança ESPERADA (competência). Ver docs/AUDITORIA-ERP.md.
// ===================================================================

enum ContractStatus {
  PENDING // aguardando início/assinatura
  ACTIVE // vigente
  RENEWAL // em processo de renovação
  OVERDUE // vencido (passou do fim sem renovar/encerrar)
  ENDED // encerrado normalmente
  CANCELED // cancelado antes do fim
}

enum ContractType {
  MRR // recorrente mensal
  TCV // valor fechado do contrato
  ONE_TIME // projeto pontual
  SETUP // implantação
  CUSTOM // personalizado
}

enum RecurrenceType {
  NONE
  MONTHLY
  QUARTERLY
  SEMIANNUAL
  ANNUAL
  CUSTOM
}

enum BillingStatus {
  PENDING // em aberto, dentro do prazo
  PARTIAL // parcialmente paga
  PAID // quitada
  OVERDUE // vencida
  CANCELED // cancelada
}

enum PaymentStatus {
  CONFIRMED
  PENDING
  FAILED
  REFUNDED
}

enum PaymentMethod {
  PIX
  TRANSFER
  BOLETO
  CARD
  CASH
  OTHER
}

enum RevenueType {
  MRR // receita recorrente
  TCV // parcela de contrato fechado
  ONE_TIME // avulsa
  SETUP // implantação
  RECOVERY // recuperação de inadimplência
  OTHER
}

enum ExpenseType {
  FIXED
  VARIABLE
  PAYROLL
  TAX
  TOOL
  ADS
  LOAN
  CARD
  OTHER
}

enum CollectionStatus {
  NOT_CONTACTED
  CONTACTED
  PROMISED // cliente prometeu pagar
  PAID
  IGNORED // cliente não responde
  ESCALATED // escalado (jurídico/negativação)
}

enum EmployeeType {
  CLT
  PJ
  FREELANCER
}

enum PayrollStatus {
  DRAFT
  APPROVED
  PAID
}

enum PayrollItemKind {
  SALARY
  BONUS
  COMMISSION
  BENEFIT
  REIMBURSEMENT
  DEDUCTION // desconto (entra negativo no total)
}

enum CommissionStatus {
  PENDING
  APPROVED
  PAID
  CANCELED
}

enum AssetType {
  CASH
  RECEIVABLE
  EQUIPMENT
  INVESTMENT
  INTANGIBLE
  OTHER
}

enum LiabilityType {
  LOAN
  TAX
  SUPPLIER
  CARD_DEBT
  LABOR
  OTHER
}

enum AlertKind {
  BILLING_DUE
  BILLING_OVERDUE
  CONTRACT_RENEWAL
  LOW_CASH
  GOAL
  PAYROLL
  CUSTOM
}

enum ImportEntity {
  CLIENTS
  CONTRACTS
  BILLINGS
  REVENUES
  EXPENSES
  EMPLOYEES
  ASSETS
  LIABILITIES
}

// ===== Comercial ====================================================

// Contato adicional do cliente (financeiro, dono, marketing...).
model ClientContact {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name      String
  role      String? // cargo/função (ex.: financeiro, sócio)
  email     String?
  phone     String?
  isPrimary Boolean  @default(false)
  notes     String?
  ownerId   String?
  owner     User?    @relation("OwnerClientContact", fields: [ownerId], references: [id])
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([clientId])
  @@index([ownerId])
}

// Serviço do catálogo da agência (tráfego, social, site, CRM...).
model Service {
  id            String   @id @default(cuid())
  name          String
  description   String?
  category      String? // trafego | social | web | consultoria | ...
  defaultPrice  Decimal? @db.Decimal(14, 2) // valor base sugerido
  estimatedCost Decimal? @db.Decimal(14, 2) // custo estimado de entrega
  defaultOwner  String? // responsável padrão pela execução
  notes         String?
  active        Boolean  @default(true)
  ownerId       String?
  owner         User?    @relation("OwnerService", fields: [ownerId], references: [id])
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)

  contractServices ContractService[]
  billings         Billing[]
  transactions     Transaction[]
  offerServices    OfferService[]
  upsells          Upsell[]
  upsellServices   UpsellService[]

  @@index([active])
  @@index([category])
  @@index([ownerId])
}

// Oferta (Plano) — pacote comercial que junta serviços com um valor.
// O PREÇO vive aqui (não no Serviço): a mesma junção de serviços pode ser
// vendida por valores diferentes em ofertas diferentes (ex.: "Avançado Óticas").
model Offer {
  id             String        @id @default(cuid())
  name           String
  description    String?
  modality       OfferModality @default(MRR) // MRR | TCV | CUSTOM (personalizado)
  defaultValue   Decimal?      @db.Decimal(14, 2) // valor padrão da oferta
  durationMonths Int? // duração padrão (meses)
  paymentMethod  String? // forma de pagamento padrão: pix | boleto | cartão | ...
  active         Boolean       @default(true)
  notes          String?
  ownerId        String?
  owner          User?         @relation("OwnerOffer", fields: [ownerId], references: [id])
  createdAt      DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @db.Timestamptz(3)

  services OfferService[]
  upsells  Upsell[]

  @@index([active])
  @@index([modality])
  @@index([ownerId])
}

// Oportunidade de UPSELL — venda interna para cliente da base.
// Valor atribuído manualmente; ao marcar como vendida (WON) pode gerar uma
// receita (Income) associada ao cliente para alimentar Dashboard/Relatórios.
model Upsell {
  id              String       @id @default(cuid())
  clientId        String
  client          Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  serviceId       String? // serviço sugerido
  service         Service?     @relation(fields: [serviceId], references: [id])
  offerId         String? // oferta sugerida, se aplicável
  offer           Offer?       @relation(fields: [offerId], references: [id])
  title           String? // descrição curta da oportunidade
  value           Decimal      @db.Decimal(14, 2) // valor potencial da venda
  responsible     String? // responsável pela oportunidade
  status          UpsellStatus @default(OPPORTUNITY)
  expectedCloseAt DateTime?    @db.Timestamptz(3) // data prevista de fechamento
  closedAt        DateTime?    @db.Timestamptz(3) // data real de fechamento (WON/LOST)
  notes           String?
  incomeId        String? // receita gerada ao vender (conciliação — legado)
  billingId       String? // cobrança lançada nos recebimentos ao vender
  ownerId         String?
  owner           User?        @relation("OwnerUpsell", fields: [ownerId], references: [id])
  createdAt       DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime     @updatedAt @db.Timestamptz(3)

  services UpsellService[] // serviços da oportunidade (N:N com valor)

  @@index([clientId])
  @@index([status])
  @@index([expectedCloseAt])
  @@index([ownerId])
}

// Serviços incluídos numa oportunidade de upsell (N:N com valor unitário) —
// permite compor a oportunidade com vários serviços, cada um com seu valor.
model UpsellService {
  id        String   @id @default(cuid())
  upsellId  String
  upsell    Upsell   @relation(fields: [upsellId], references: [id], onDelete: Cascade)
  serviceId String
  service   Service  @relation(fields: [serviceId], references: [id])
  unitPrice Decimal  @default(0) @db.Decimal(14, 2)
  ownerId   String?
  owner     User?    @relation("OwnerUpsellService", fields: [ownerId], references: [id])
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@unique([upsellId, serviceId])
  @@index([upsellId])
  @@index([serviceId])
  @@index([ownerId])
}

// Serviços incluídos em uma oferta (N:N).
model OfferService {
  id        String   @id @default(cuid())
  offerId   String
  offer     Offer    @relation(fields: [offerId], references: [id], onDelete: Cascade)
  serviceId String
  service   Service  @relation(fields: [serviceId], references: [id])
  ownerId   String?
  owner     User?    @relation("OwnerOfferService", fields: [ownerId], references: [id])
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@unique([offerId, serviceId])
  @@index([offerId])
  @@index([serviceId])
  @@index([ownerId])
}

// Contrato do cliente — fonte de MRR (monthlyValue) e TCV (totalValue).
model Contract {
  id            String         @id @default(cuid())
  clientId      String
  client        Client         @relation(fields: [clientId], references: [id])
  title         String
  type          ContractType   @default(MRR)
  status        ContractStatus @default(ACTIVE)
  recurrence    RecurrenceType @default(MONTHLY)
  monthlyValue  Decimal        @default(0) @db.Decimal(14, 2) // base do MRR
  totalValue    Decimal        @default(0) @db.Decimal(14, 2) // TCV vendido
  setupFee      Decimal?       @db.Decimal(14, 2)
  startDate     DateTime       @db.Timestamptz(3)
  endDate       DateTime?      @db.Timestamptz(3)
  renewalDate   DateTime?      @db.Timestamptz(3) // próxima renovação
  billingDay    Int            @default(5) // dia de cobrança (1-28)
  // Renovação/pagamento (preenchidos ao renovar na carteira)
  paymentMethod String? // pix | boleto | cartão | transferência | outro
  paymentMode   String? // à vista | parcelado | mensal
  autoRenew     Boolean        @default(false)
  canceledAt    DateTime?      @db.Timestamptz(3)
  notes         String?
  ownerId       String?
  owner         User?          @relation("OwnerContract", fields: [ownerId], references: [id])
  createdAt     DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime       @updatedAt @db.Timestamptz(3)

  terms       CommercialTerm[]
  services    ContractService[]
  billings    Billing[]
  commissions Commission[]
  incomes     Income[]

  @@index([clientId])
  @@index([status])
  @@index([startDate])
  @@index([renewalDate])
  @@index([ownerId])
}

// Serviços incluídos em um contrato (N:N com preço/quantidade).
model ContractService {
  id         String   @id @default(cuid())
  contractId String
  contract   Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  serviceId  String
  service    Service  @relation(fields: [serviceId], references: [id])
  quantity   Int      @default(1)
  unitPrice  Decimal  @default(0) @db.Decimal(14, 2)
  notes      String?
  ownerId    String?
  owner      User?    @relation("OwnerContractService", fields: [ownerId], references: [id])
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  @@unique([contractId, serviceId])
  @@index([contractId])
  @@index([serviceId])
  @@index([ownerId])
}

// ===== Cobrança (competência) =======================================

// Cobrança ao cliente — receita ESPERADA por competência (mês/ano).
// Distinta de CreditCardInvoice (fatura do cartão da agência) e de
// Income (receita efetivamente RECEBIDA / caixa).
model Billing {
  id              String        @id @default(cuid())
  clientId        String
  client          Client        @relation(fields: [clientId], references: [id])
  contractId      String?
  contract        Contract?     @relation(fields: [contractId], references: [id])
  serviceId       String? // serviço principal, quando aplicável
  service         Service?      @relation(fields: [serviceId], references: [id])
  description     String
  competenceMonth Int // 1-12
  competenceYear  Int
  /// Competência canônica YYYY-MM (01 §3.15) — preenchida por gatilho
  /// a partir do par mês/ano acima; nunca escrever pela aplicação.
  competence      String?
  amount          Decimal       @db.Decimal(14, 2)
  paidTotal       Decimal       @default(0) @db.Decimal(14, 2)
  dueDate         DateTime      @db.Timestamptz(3)
  paidAt          DateTime?     @db.Timestamptz(3) // quitação total
  status          BillingStatus @default(PENDING)
  revenueType     RevenueType   @default(MRR)

  // ===== F1.4 — Billing 2.0 (01 §4.5) =====
  /// O QUE está sendo cobrado. revenueType continua para não quebrar as
  /// métricas do v1; billingKind é o vocabulário da spec e inclui os casos
  /// que revenueType não sabia nomear (upsell, renegociação).
  billingKind        BillingKind               @default(MRR)
  /// REVENUE reconhece receita; SETTLEMENT_ONLY só liquida dívida antiga —
  /// cobrar uma renegociação NÃO cria faturamento novo, senão o mesmo
  /// dinheiro seria contado duas vezes.
  recognitionMode    RecognitionMode           @default(REVENUE)
  /// Parcelamento de TCV (F1.7): todas as parcelas do mesmo contrato
  /// compartilham o grupo, e a numeração diz qual é qual.
  installmentGroupId String?
  installmentNumber  Int?
  /// A cobrança pertence à RELAÇÃO cliente↔agência (01 §4.5). Nulo só no
  /// legado anterior ao backfill.
  relationshipId     String?
  relationship       ClientAgencyRelationship? @relation(fields: [relationshipId], references: [id], onDelete: SetNull)
  applications       PaymentApplication[]
  collectionStatus   CollectionStatus          @default(NOT_CONTACTED)
  collector          String? // responsável pela cobrança
  canceledAt         DateTime?                 @db.Timestamptz(3)
  cancelReason       String? // motivo da remoção do ciclo do mês
  canceledBy         String? // e-mail de quem removeu
  notes              String?

  // ===== Fechamento mensal (regra contábil B2C) =====
  // isLate: quitada DEPOIS do vencimento mas DENTRO do mês de competência
  //   → conta no mês, com "!" discreto de atraso.
  // paidInDifferentMonth: quitada em mês POSTERIOR à competência
  //   → o mês original permanece inadimplente na contabilidade gerencial e
  //   o valor entra no mês do pagamento como RECEITA EXTRA automática.
  isLate               Boolean @default(false)
  paidInDifferentMonth Boolean @default(false)

  extraRevenue ExtraRevenue? // receita extra automática gerada (recuperação)
  ownerId      String?
  owner        User?         @relation("OwnerBilling", fields: [ownerId], references: [id])
  createdAt    DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime      @updatedAt @db.Timestamptz(3)

  payments Payment[]
  history  CollectionHistory[]
  incomes  Income[] // recebimentos conciliados no caixa

  @@index([clientId])
  @@index([contractId])
  @@index([status])
  @@index([dueDate])
  @@index([competenceYear, competenceMonth])
  @@index([collectionStatus])
  @@index([relationshipId])
  @@index([installmentGroupId])
  @@index([ownerId])
  @@index([competence])
  @@index([ownerId, competence])
}

// ===== Receita Extra (camada GERENCIAL do faturamento) ====================
// Regra oficial: Faturamento = Recebimentos do mês correto + Receitas Extras.
// Pagamento de cobrança de competência ANTERIOR recebido em mês posterior
// vira Receita Extra AUTOMÁTICA (RECOVERY_OF_OVERDUE) no mês do pagamento —
// o mês original permanece inadimplente no fechamento. Idempotência:
// originBillingId é ÚNICO (nunca há 2 receitas extras para a mesma cobrança).
// NÃO é caixa (o Payment/Income já registram o dinheiro) — é classificação.

enum ExtraRevenueType {
  RECOVERY_OF_OVERDUE // recuperação de inadimplência de mês anterior
  MANUAL_EXTRA_REVENUE // lançamento manual
  ONE_TIME_SERVICE // serviço pontual
  ADJUSTMENT // ajuste
  OTHER
}

enum ExtraRevenueOrigin {
  AUTOMATIC
  MANUAL
}

model ExtraRevenue {
  id                     String             @id @default(cuid())
  clientId               String?
  client                 Client?            @relation(fields: [clientId], references: [id], onDelete: SetNull)
  // Cobrança original recuperada (única → idempotência da geração automática)
  originBillingId        String?            @unique
  originBilling          Billing?           @relation(fields: [originBillingId], references: [id], onDelete: SetNull)
  sourcePaymentId        String? // pagamento que originou (rastreio)
  type                   ExtraRevenueType   @default(RECOVERY_OF_OVERDUE)
  origin                 ExtraRevenueOrigin @default(AUTOMATIC)
  description            String
  amount                 Decimal            @db.Decimal(14, 2)
  receivedAt             DateTime           @default(now()) @db.Timestamptz(3)
  // Competência ORIGINAL da cobrança recuperada (de onde o valor "veio")
  originalReferenceMonth Int?
  originalReferenceYear  Int?
  ownerId                String?
  owner                  User?              @relation("OwnerExtraRevenue", fields: [ownerId], references: [id])
  createdAt              DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime           @updatedAt @db.Timestamptz(3)

  @@index([clientId])
  @@index([receivedAt])
  @@index([type])
  @@index([ownerId])
}

// Pagamento de uma cobrança (permite parcial; histórico preservado).
model Payment {
  id        String        @id @default(cuid())
  billingId String
  billing   Billing       @relation(fields: [billingId], references: [id], onDelete: Cascade)
  amount    Decimal       @db.Decimal(14, 2)
  paidAt    DateTime      @default(now()) @db.Timestamptz(3)
  method    PaymentMethod @default(PIX)
  status    PaymentStatus @default(CONFIRMED)
  accountId String? // conta bancária que recebeu
  account   Account?      @relation(fields: [accountId], references: [id])
  notes     String?

  // ===== Idempotência de pagamento EXTERNO (01 §3.3; 03 §4.3) =====
  // Webhook de gateway reenvia o mesmo evento; a trava tem que estar no
  // BANCO, não na aplicação (cenário S20: webhook duplicado aceita um único
  // Payment). Nulo para pagamento lançado à mão — só o externo é chaveado.
  /// Identificador do pagamento no sistema de origem (gateway, banco).
  externalId     String?
  /// Origem do pagamento externo ("stripe", "asaas", "ofx"...).
  externalSource String?
  /// Chave de deduplicação do evento externo, quando a origem fornece uma.
  idempotencyKey String?

  /// Aplicações deste pagamento em cobranças (01 §4.5). Um pagamento pode
  /// quitar várias cobranças; billingId acima é a cobrança de ORIGEM, mantida
  /// para o caminho 1:1 do v1 continuar funcionando.
  applications PaymentApplication[]

  ownerId   String?
  owner     User?    @relation("OwnerPayment", fields: [ownerId], references: [id])
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@unique([externalSource, externalId])
  @@unique([idempotencyKey])
  @@index([billingId])
  @@index([paidAt])
  @@index([status])
  @@index([ownerId])
}

// Histórico de cobrança (interações com o cliente — nunca sobrescrever).
model CollectionHistory {
  id             String                    @id @default(cuid())
  billingId      String
  billing        Billing                   @relation(fields: [billingId], references: [id], onDelete: Cascade)
  clientId       String?
  client         Client?                   @relation(fields: [clientId], references: [id])
  status         CollectionStatus          @default(CONTACTED)
  channel        String? // whatsapp | email | telefone | outro
  message        String? // texto enviado / resumo do contato
  contactedAt    DateTime                  @default(now()) @db.Timestamptz(3)
  nextActionAt   DateTime?                 @db.Timestamptz(3) // próximo follow-up
  actionType     String? // PAYMENT_REGISTERED, STATUS_CHANGED, DELETED, etc. (audit)
  createdBy      String? // user.email (quem fez a ação)
  relationshipId String?
  relationship   ClientAgencyRelationship? @relation(fields: [relationshipId], references: [id], onDelete: SetNull)
  ownerId        String?
  owner          User?                     @relation("OwnerCollectionHistory", fields: [ownerId], references: [id])
  createdAt      DateTime                  @default(now()) @db.Timestamptz(3)

  @@index([billingId])
  @@index([clientId])
  @@index([relationshipId])
  @@index([contactedAt])
  @@index([ownerId])
}

// ===== Custos e resultado ===========================================

// ===== Folha e comissões ============================================

// Colaborador da agência (CLT, PJ ou freelancer).
model Employee {
  id         String       @id @default(cuid())
  name       String
  role       String? // função (gestor de tráfego, designer...)
  type       EmployeeType @default(PJ)
  baseSalary Decimal      @default(0) @db.Decimal(14, 2)
  active     Boolean      @default(true)
  personId   String? // reaproveita contato de Pessoas (opcional)
  person     Person?      @relation(fields: [personId], references: [id])
  startedAt  DateTime?    @db.Timestamptz(3)
  endedAt    DateTime?    @db.Timestamptz(3)
  notes      String?
  ownerId    String?
  owner      User?        @relation("OwnerEmployee", fields: [ownerId], references: [id])
  createdAt  DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime     @updatedAt @db.Timestamptz(3)

  assignments       ClientManagerAssignment[]
  payrollItems      PayrollItem[]
  commissions       Commission[]
  salesOwnedClients Client[]                  @relation("ClientSalesOwner")

  @@index([active])
  @@index([ownerId])
}

// Folha de pagamento de um mês (run) — itens preservam o histórico.
model Payroll {
  id         String        @id @default(cuid())
  month      Int // 1-12
  year       Int
  /// Competência canônica YYYY-MM (01 §3.15) — preenchida por gatilho
  /// a partir do par mês/ano acima; nunca escrever pela aplicação.
  competence String?
  status     PayrollStatus @default(DRAFT)
  paidAt     DateTime?     @db.Timestamptz(3)
  notes      String?
  ownerId    String?
  owner      User?         @relation("OwnerPayroll", fields: [ownerId], references: [id])
  createdAt  DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime      @updatedAt @db.Timestamptz(3)

  items PayrollItem[]

  @@unique([ownerId, year, month])
  @@index([year, month])
  @@index([status])
  @@index([ownerId])
  @@index([competence])
  @@index([ownerId, competence])
}

// Item da folha (salário, bônus, comissão, benefício, desconto).
model PayrollItem {
  id         String          @id @default(cuid())
  payrollId  String
  payroll    Payroll         @relation(fields: [payrollId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee        @relation(fields: [employeeId], references: [id])
  kind       PayrollItemKind @default(SALARY)
  amount     Decimal         @db.Decimal(14, 2) // DEDUCTION entra negativo
  notes      String?
  ownerId    String?
  owner      User?           @relation("OwnerPayrollItem", fields: [ownerId], references: [id])
  createdAt  DateTime        @default(now()) @db.Timestamptz(3)

  @@index([payrollId])
  @@index([employeeId])
  @@index([ownerId])
}

// Comissão de colaborador (por cliente/contrato, com competência).
model Commission {
  id          String           @id @default(cuid())
  employeeId  String
  employee    Employee         @relation(fields: [employeeId], references: [id])
  clientId    String?
  client      Client?          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  contractId  String?
  contract    Contract?        @relation(fields: [contractId], references: [id])
  basisAmount Decimal?         @db.Decimal(14, 2) // base de cálculo
  rate        Decimal?         @db.Decimal(7, 4) // percentual (0–1)
  amount      Decimal          @db.Decimal(14, 2)
  month       Int // competência 1-12
  year        Int
  /// Competência canônica YYYY-MM (01 §3.15) — preenchida por gatilho
  /// a partir do par mês/ano acima; nunca escrever pela aplicação.
  competence  String?
  status      CommissionStatus @default(PENDING)
  paidAt      DateTime?        @db.Timestamptz(3)
  notes       String?
  ownerId     String?
  owner       User?            @relation("OwnerCommission", fields: [ownerId], references: [id])
  createdAt   DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @db.Timestamptz(3)

  @@index([employeeId])
  @@index([clientId])
  @@index([contractId])
  @@index([year, month])
  @@index([status])
  @@index([ownerId])
  @@index([competence])
  @@index([ownerId, competence])
}

// ===== Patrimônio ===================================================

// Ativo da empresa (equipamento, investimento, valores a receber...).
model Asset {
  id         String    @id @default(cuid())
  name       String
  type       AssetType @default(OTHER)
  value      Decimal   @db.Decimal(14, 2)
  acquiredAt DateTime? @db.Timestamptz(3)
  notes      String?
  ownerId    String?
  owner      User?     @relation("OwnerAsset", fields: [ownerId], references: [id])
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @db.Timestamptz(3)

  @@index([type])
  @@index([ownerId])
}

// Passivo da empresa (dívidas, impostos, fornecedores...).
model Liability {
  id             String        @id @default(cuid())
  name           String
  type           LiabilityType @default(OTHER)
  totalValue     Decimal       @db.Decimal(14, 2)
  remainingValue Decimal       @db.Decimal(14, 2)
  dueDate        DateTime?     @db.Timestamptz(3)
  installments   Int?
  monthlyPayment Decimal?      @db.Decimal(14, 2)
  notes          String?
  ownerId        String?
  owner          User?         @relation("OwnerLiability", fields: [ownerId], references: [id])
  createdAt      DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @db.Timestamptz(3)

  loans Loan[]

  @@index([type])
  @@index([dueDate])
  @@index([ownerId])
}

// Empréstimo tomado (detalha um passivo do tipo LOAN).
model Loan {
  id               String     @id @default(cuid())
  lender           String // credor (banco, pessoa...)
  principal        Decimal    @db.Decimal(14, 2)
  interestRate     Decimal?   @db.Decimal(7, 4) // taxa mensal (0–1)
  installments     Int        @default(1)
  installmentValue Decimal?   @db.Decimal(14, 2)
  remainingValue   Decimal?   @db.Decimal(14, 2)
  firstDueDate     DateTime?  @db.Timestamptz(3)
  liabilityId      String?
  liability        Liability? @relation(fields: [liabilityId], references: [id])
  notes            String?
  ownerId          String?
  owner            User?      @relation("OwnerLoan", fields: [ownerId], references: [id])
  createdAt        DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime   @updatedAt @db.Timestamptz(3)

  @@index([liabilityId])
  @@index([ownerId])
}

// ===== Plataforma (importação, exportação, alertas) =================

// Modelo de planilha para importação em massa por entidade.
model ImportTemplate {
  id        String       @id @default(cuid())
  name      String
  entity    ImportEntity
  columns   Json? // definição das colunas do modelo gerado
  notes     String?
  ownerId   String?
  owner     User?        @relation("OwnerImportTemplate", fields: [ownerId], references: [id])
  createdAt DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt DateTime     @updatedAt @db.Timestamptz(3)

  @@index([entity])
  @@index([ownerId])
}

// Registro de relatório exportado (histórico + configuração reusável).
model ExportReport {
  id          String   @id @default(cuid())
  name        String
  module      String // clientes | contratos | cobrancas | despesas | ...
  format      String   @default("XLSX") // CSV | XLSX | PDF
  filters     Json? // filtros aplicados na geração
  fileName    String?
  generatedAt DateTime @default(now()) @db.Timestamptz(3)
  ownerId     String?
  owner       User?    @relation("OwnerExportReport", fields: [ownerId], references: [id])

  @@index([module])
  @@index([generatedAt])
  @@index([ownerId])
}

// Alerta financeiro (vencimento, renovação, caixa baixo...).
model FinancialAlert {
  id         String    @id @default(cuid())
  kind       AlertKind @default(CUSTOM)
  title      String
  body       String?
  refType    String? // billing | contract | payroll | ...
  refId      String?
  dueAt      DateTime? @db.Timestamptz(3)
  readAt     DateTime? @db.Timestamptz(3)
  resolvedAt DateTime? @db.Timestamptz(3)
  ownerId    String?
  owner      User?     @relation("OwnerFinancialAlert", fields: [ownerId], references: [id])
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)

  @@index([kind])
  @@index([dueAt])
  @@index([readAt])
  @@index([ownerId])
}

// Visão salva: conjunto de filtros nomeado, por módulo.
model SavedView {
  id         String         @id @default(cuid())
  name       String
  module     String // clientes | contratos | cobrancas | receitas | despesas | caixa | folha | dashboard | relatorio-<tipo>
  params     String // querystring dos filtros aplicados
  visibility ViewVisibility @default(PRIVATE)
  createdBy  String? // userId do criador (visibilidade privada)
  ownerId    String?
  owner      User?          @relation("OwnerSavedView", fields: [ownerId], references: [id])
  createdAt  DateTime       @default(now()) @db.Timestamptz(3)

  @@index([ownerId, module])
  @@index([createdBy])
}

enum ViewVisibility {
  PRIVATE // só o criador vê
  GLOBAL // todos os usuários da agência veem
}

// Meta anual de faturamento (bloco META ANUAL do Painel Anual — planilha).
model AnnualTarget {
  id            String   @id @default(cuid())
  year          Int
  revenueTarget Decimal  @db.Decimal(14, 2)
  ownerId       String?
  owner         User?    @relation("OwnerAnnualTarget", fields: [ownerId], references: [id])
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)

  @@unique([ownerId, year])
  @@index([ownerId])
}

// ===================================================================
// Contratos documentais — modelos DOCX com variáveis {{ }} e geração
// de contratos preenchidos. NÃO confundir com Contract (acordo
// comercial/financeiro MRR-TCV, base de cobranças e renovação).
// Arquivos ficam no storage (src/lib/storage); o banco guarda só
// caminho + metadados. Variáveis: Json de TemplateVariable
// { originalToken, rawName, key, label, type, required, clientField }.
// ===================================================================

enum ContractTemplateStatus {
  DRAFT // enviado mas ainda em ajuste
  ACTIVE // pronto para gerar contratos
  ARCHIVED // fora de uso, mantido por histórico
}

enum GeneratedContractStatus {
  GENERATED // gerado, ainda não enviado
  SENT // enviado ao cliente
  SIGNED // assinado
  CANCELED // cancelado
  ARCHIVED // arquivado
}

enum ContractCommercialType {
  MRR // recorrente mensal
  TCV // valor total do contrato
  ONE_TIME // avulso
  CUSTOM // personalizado
}

enum BillingModel {
  MONTHLY // mensal
  UPFRONT // à vista
  INSTALLMENTS // parcelado
  CUSTOM // personalizado
}

enum ContractDurationType {
  MONTHLY // mensal
  QUARTERLY // trimestral
  SEMIANNUAL // semestral
  ANNUAL // anual
  CUSTOM // personalizado
}

enum ClientDocumentType {
  CONTRACT // contrato
  PROPOSAL // proposta
  RECEIPT // comprovante
  BRIEFING // briefing
  LEGAL_DOCUMENT // documento jurídico
  OTHER // outro
}

// Modelo de contrato enviado em DOCX (biblioteca de modelos).
model ContractTemplate {
  id          String  @id @default(cuid())
  name        String
  description String?

  // Metadados comerciais (organização/filtros; não substituem o texto)
  commercialType   ContractCommercialType?
  billingModel     BillingModel?
  durationType     ContractDurationType?
  durationMonths   Int?
  monthlyAmount    Decimal?                @db.Decimal(14, 2)
  totalAmount      Decimal?                @db.Decimal(14, 2)
  defaultDueDay    Int? // dia padrão de vencimento (1-28)
  includedServices Json? // string[] — serviços incluídos
  internalNotes    String?

  // Arquivo original (imutável — a geração nunca altera o modelo)
  originalFileName String
  filePath         String
  mimeType         String
  fileSize         Int
  fileHash         String?

  // Variáveis {{ }} detectadas + alertas de variáveis pouco claras
  variables Json // TemplateVariable[]
  warnings  Json? // string[]

  status ContractTemplateStatus @default(ACTIVE)

  ownerId String?
  owner   User?   @relation("OwnerContractTemplate", fields: [ownerId], references: [id])

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  generated GeneratedContract[]
  formLinks ContractFormLink[]

  @@index([ownerId])
  @@index([status])
}

// Contrato gerado a partir de um modelo (DOCX preenchido).
model GeneratedContract {
  id         String            @id @default(cuid())
  templateId String?
  template   ContractTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  clientId   String?
  client     Client?           @relation(fields: [clientId], references: [id], onDelete: SetNull)

  name           String
  commercialType ContractCommercialType?
  amount         Decimal?                @db.Decimal(14, 2)
  startDate      DateTime?               @db.Timestamptz(3)
  dueDay         Int?

  filledVariables   Json // { rawName: valor } usado na geração
  generatedFileName String
  generatedFilePath String

  status      GeneratedContractStatus @default(GENERATED)
  generatedAt DateTime                @default(now()) @db.Timestamptz(3)

  // Origem: preenchido via link público de formulário (null = wizard interno).
  formLinkId String?
  formLink   ContractFormLink? @relation(fields: [formLinkId], references: [id], onDelete: SetNull)

  ownerId String?
  owner   User?   @relation("OwnerGeneratedContract", fields: [ownerId], references: [id])

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([templateId])
  @@index([clientId])
  @@index([ownerId])
  @@index([status])
}

// Link PÚBLICO de formulário de um modelo de contrato (substitui o ZapSign):
// quem abrir /f/{token} responde as variáveis e o contrato é gerado dentro
// da plataforma. Modelo GLOBAL de propósito (fora de OWNED_MODELS): o lookup
// por token acontece SEM sessão; o token é opaco/inadivinhável e o ownerId
// explícito fixa o dono via runWithOwner no restante do fluxo.
model ContractFormLink {
  id         String           @id @default(cuid())
  token      String           @unique
  templateId String
  template   ContractTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  // Link direcionado: pré-preenche os dados deste cliente no formulário.
  clientId String?
  client   Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  active      Boolean @default(true)
  submissions Int     @default(0)

  ownerId String

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  generated GeneratedContract[]

  @@index([templateId])
}

// Documento anexado ao cliente (contratos assinados, comprovantes...).
model ClientDocument {
  id       String @id @default(cuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  name         String
  description  String?
  documentType ClientDocumentType @default(OTHER)
  fileName     String
  filePath     String
  mimeType     String
  size         Int

  ownerId String?
  owner   User?   @relation("OwnerClientDocument", fields: [ownerId], references: [id])

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([clientId])
  @@index([ownerId])
}

// Contexto interno do cliente (observações, negociação, alertas).
model ClientNote {
  id       String @id @default(cuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  title   String
  content String
  type    String? // observacao | comercial | negociacao | atendimento | alerta

  ownerId String?
  owner   User?   @relation("OwnerClientNote", fields: [ownerId], references: [id])

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([clientId])
  @@index([ownerId])
}

// ===========================================================================
// RELAÇÃO CLIENTE ↔ AGÊNCIA (F1.1 · ref. 01 §4.3 e §3.9)
//
// O Client vira MESTRE: identidade, documento, contatos. Tudo que é
// operacional — status, gestores, contratos, cobranças, avaliações,
// onboarding — passa a pertencer à RELAÇÃO com uma agência.
//
// Por que isso importa: o mesmo cliente pode estar ativo em duas agências
// com contratos, gestores e cobranças distintos (01 §4.3). Com agencia_id
// no Client isso obrigaria a cadastrar a mesma empresa duas vezes, que é
// exatamente a duplicação que o dedupe da F1.16 combate.
// ===========================================================================

/// 01 §3.9 — quatro dimensões INDEPENDENTES. Um cliente pode estar ACTIVE
/// no ciclo de vida e OVERDUE no financeiro ao mesmo tempo; misturar as
/// duas coisas num status só foi a origem de metade das ambiguidades do v1.
enum LifecycleStatus {
  PROSPECT
  ONBOARDING
  ACTIVE
  PAUSED
  CHURNED
  INACTIVE
}

/// Derivado das cobranças — guardado como CACHE para a listagem não ter de
/// recalcular por linha. A verdade continua sendo o Billing.
enum FinancialStatus {
  REGULAR
  DUE_SOON
  OVERDUE
  DELINQUENT
  WRITE_OFF
}

/// Também cache, derivado do termo comercial vigente e da renovação.
enum RenewalStatus {
  NOT_APPLICABLE
  UPCOMING
  NEGOTIATING
  RENEWED
  LOST
}

enum OnboardingStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETE
  EXCEPTION
}

model ClientAgencyRelationship {
  id       String @id @default(cuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  agencyId String
  agency   Agency @relation(fields: [agencyId], references: [id])

  lifecycleStatus  LifecycleStatus  @default(ACTIVE)
  financialStatus  FinancialStatus  @default(REGULAR)
  renewalStatus    RenewalStatus    @default(NOT_APPLICABLE)
  onboardingStatus OnboardingStatus @default(NOT_STARTED)

  startedAt DateTime? @db.Timestamptz(3)
  pausedAt  DateTime? @db.Timestamptz(3)
  churnedAt DateTime? @db.Timestamptz(3)
  endedAt   DateTime? @db.Timestamptz(3)

  /// Termo comercial VIGENTE (F1.2). É cache de conveniência: a verdade é
  /// a linha do tempo em CommercialTerm, e quem pergunta "quanto valia em
  /// março?" tem de olhar a vigência, nunca este campo.
  currentCommercialTermId String?         @unique
  currentCommercialTerm   CommercialTerm? @relation("TermoVigente", fields: [currentCommercialTermId], references: [id], onDelete: SetNull)

  ownerId String?
  owner   User?   @relation("OwnerClientRelationship", fields: [ownerId], references: [id])

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  losses      ClientLoss[]
  collections CollectionHistory[]
  avaliacoes  AvaliacaoMensal[]
  onboarding  OnboardingTask[]
  terms       CommercialTerm[]          @relation("TermosDaRelacao")
  managers    ClientManagerAssignment[]
  billings    Billing[]
  credits     CustomerCredit[]

  /// Um cliente tem no máximo UMA relação por agência: duas seriam duas
  /// carteiras do mesmo cliente na mesma agência, que é o bug, não o caso.
  @@unique([clientId, agencyId])
  @@index([clientId])
  @@index([agencyId])
  @@index([lifecycleStatus])
  @@index([financialStatus])
  @@index([ownerId])
}

/// AVALIAÇÃO MENSAL (F1.17 · ref. 01 §4.13, 02 §4.1).
/// Fotografia do mês feita pelo gestor. Copia os gestores vigentes para
/// virar registro histórico, mas NÃO é fonte de vigência (01 §4.3) — quem
/// manda nisso é ClientManagerAssignment (F1.3).
model AvaliacaoMensal {
  id             String                   @id @default(cuid())
  relationshipId String
  relationship   ClientAgencyRelationship @relation(fields: [relationshipId], references: [id], onDelete: Cascade)

  /// Competência YYYY-MM (01 §3.15).
  competence String

  estabilidade String? // ex.: estavel | oscilando | caindo
  ads          String? // ex.: rodando | pausado | sem verba
  risco        String? // ex.: baixo | medio | alto
  upsell       String? // ex.: sem | mapeado | proposto
  observacao   String?

  /// Snapshot dos gestores no momento da avaliação.
  gestores String[] @default([])

  confirmedAt DateTime? @db.Timestamptz(3)
  confirmedBy String?

  ownerId String?
  owner   User?   @relation("OwnerAvaliacaoMensal", fields: [ownerId], references: [id])

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  /// Idempotência de 03 §4.3: uma avaliação por relação por competência.
  @@unique([relationshipId, competence])
  @@index([competence])
  @@index([ownerId])
}

/// ONBOARDING (F1.18 · ref. 01 §4.11, 02 §4.2). Prazos D+7/30/90.
model OnboardingTask {
  id             String                   @id @default(cuid())
  relationshipId String
  relationship   ClientAgencyRelationship @relation(fields: [relationshipId], references: [id], onDelete: Cascade)

  title       String
  description String?
  /// Ordem no board do cliente.
  position    Int       @default(0)
  /// Dias após a entrada (7, 30, 90) — a data efetiva sai de startedAt.
  offsetDays  Int?
  dueAt       DateTime? @db.Timestamptz(3)
  doneAt      DateTime? @db.Timestamptz(3)
  doneBy      String?
  /// Chave do template que originou a tarefa (rastreia o padrão aplicado).
  templateKey String?

  ownerId String?
  owner   User?   @relation("OwnerOnboardingTask", fields: [ownerId], references: [id])

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([relationshipId])
  @@index([dueAt])
  @@index([ownerId])
}

// ===========================================================================
// TERMO COMERCIAL (F1.2 · ref. 01 §4.4)
//
// "CommercialTerm (fonte temporal)". É a linha do tempo do que foi
// combinado: modalidade, valor e prazo, cada versão com vigência.
//
// POR QUE ISSO EXISTE: no v1 o valor morava em Client.monthlyValue, um
// campo só. Reajustar o cliente sobrescrevia o passado — e a partir daí
// nenhuma métrica histórica sabia quanto ele valia em março. 01 §4.4 é
// categórico: "Client.monthlyValue existe só como cache do valor atual;
// métrica histórica NUNCA o usa".
// ===========================================================================
model CommercialTerm {
  id             String                   @id @default(cuid())
  relationshipId String
  relationship   ClientAgencyRelationship @relation("TermosDaRelacao", fields: [relationshipId], references: [id], onDelete: Cascade)

  modality           ClientModality
  monthlyValue       Decimal?       @db.Decimal(14, 2)
  totalContractValue Decimal?       @db.Decimal(14, 2)
  contractMonths     Int?

  /// Vigência. validTo nulo = termo em vigor.
  validFrom DateTime  @db.Timestamptz(3)
  validTo   DateTime? @db.Timestamptz(3)

  contractId String?
  contract   Contract? @relation(fields: [contractId], references: [id], onDelete: SetNull)

  /// Por que este termo nasceu: reajuste, renovação, upsell, migração.
  reason String?

  /// Lado inverso do cache de vigente na relação.
  vigenteEm ClientAgencyRelationship? @relation("TermoVigente")

  ownerId String?
  owner   User?   @relation("OwnerCommercialTerm", fields: [ownerId], references: [id])

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([relationshipId, validFrom])
  @@index([validFrom])
  @@index([ownerId])
}

// ===========================================================================
// VIGÊNCIA DE GESTORES (F1.3 · ref. 01 §4.3)
//
// "ClientManagerAssignment: relationshipId, managerId, role, validFrom,
// validTo, changedBy, reason. A AvaliacaoMensal copia gestores para
// fotografia, mas NÃO é fonte de vigência."
//
// Mesma doença que o valor tinha antes da F1.2: no v1 o responsável era um
// campo no Client, então trocar de gestor apagava quem cuidava do cliente
// no ano passado — e com isso qualquer apuração de comissão ou de carteira
// por gestor passava a mentir sobre o passado.
// ===========================================================================

enum ManagerRole {
  MANAGER_1
  MANAGER_2
  COMMERCIAL_ORIGIN
  SDR_ORIGIN
}

model ClientManagerAssignment {
  id             String                   @id @default(cuid())
  relationshipId String
  relationship   ClientAgencyRelationship @relation(fields: [relationshipId], references: [id], onDelete: Cascade)
  managerId      String
  manager        Employee                 @relation(fields: [managerId], references: [id], onDelete: Cascade)

  role ManagerRole

  validFrom DateTime  @db.Timestamptz(3)
  validTo   DateTime? @db.Timestamptz(3)

  /// Quem mexeu e por quê — a atribuição é dado de gestão, não detalhe.
  changedBy String?
  reason    String?

  ownerId String?
  owner   User?   @relation("OwnerManagerAssignment", fields: [ownerId], references: [id])

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([relationshipId, role, validFrom])
  @@index([managerId])
  @@index([ownerId])
}

// ===========================================================================
// BILLING 2.0 — APLICAÇÃO DE PAGAMENTO E CRÉDITO (F1.4 · ref. 01 §4.5, §3.12)
// ===========================================================================

/// O QUE está sendo cobrado (01 §4.5). Convive com RevenueType, que o v1
/// usa nas métricas: este é o vocabulário da spec, aquele é o do legado.
enum BillingKind {
  MRR
  TCV
  SETUP
  ONE_TIME
  UPSELL
  RENEGOTIATION
}

/// Cobrança que RECONHECE receita x cobrança que só LIQUIDA dívida antiga.
/// Renegociação é SETTLEMENT_ONLY: o faturamento já foi reconhecido quando a
/// dívida nasceu, e contá-lo de novo dobraria a receita (01 §3.13).
enum RecognitionMode {
  REVENUE
  SETTLEMENT_ONLY
}

/// Liga pagamento e cobrança com o VALOR aplicado (01 §4.5). É o que permite
/// um pagamento só quitar várias cobranças — e é por isso que paidTotal
/// passou a ser derivado daqui em vez de somado na mão.
model PaymentApplication {
  id        String  @id @default(cuid())
  paymentId String
  payment   Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  billingId String
  billing   Billing @relation(fields: [billingId], references: [id], onDelete: Cascade)

  amount    Decimal  @db.Decimal(14, 2)
  appliedAt DateTime @default(now()) @db.Timestamptz(3)

  ownerId String?
  owner   User?   @relation("OwnerPaymentApplication", fields: [ownerId], references: [id])

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  /// Um pagamento aplica no máximo uma vez em cada cobrança: duas linhas
  /// seriam a mesma aplicação contada em dobro.
  @@unique([paymentId, billingId])
  @@index([billingId])
  @@index([ownerId])
}

enum CreditMovementKind {
  IN
  OUT
}

/// Crédito do cliente (01 §3.12): pagamento a maior não é erro nem receita —
/// vira saldo a favor, para abater cobrança futura.
model CustomerCredit {
  id             String                    @id @default(cuid())
  clientId       String
  client         Client                    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  relationshipId String?
  relationship   ClientAgencyRelationship? @relation(fields: [relationshipId], references: [id], onDelete: SetNull)

  /// Saldo atual. Derivado dos movimentos, materializado para leitura.
  balance Decimal @default(0) @db.Decimal(14, 2)

  movements CustomerCreditMovement[]

  ownerId String?
  owner   User?   @relation("OwnerCustomerCredit", fields: [ownerId], references: [id])

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  /// Um saldo por cliente por relação.
  @@unique([clientId, relationshipId])
  @@index([ownerId])
}

/// Cada entrada e cada uso do crédito, com a origem. Sem isto o saldo seria
/// um número sem história — e crédito sem história é reclamação garantida.
model CustomerCreditMovement {
  id       String             @id @default(cuid())
  creditId String
  credit   CustomerCredit     @relation(fields: [creditId], references: [id], onDelete: Cascade)
  kind     CreditMovementKind
  amount   Decimal            @db.Decimal(14, 2)

  /// De onde veio (pagamento a maior) ou onde foi usado (cobrança abatida).
  sourcePaymentId String?
  targetBillingId String?
  reason          String?

  ownerId String?
  owner   User?   @relation("OwnerCreditMovement", fields: [ownerId], references: [id])

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([creditId])
  @@index([ownerId])
}

// ===========================================================================
// TRILHA DE AUDITORIA (F1.9 · ref. 01 §4.10)
//
// "AuditLog append-only campo a campo nas entidades financeiras e de
// carteira, com origem e motivo; helper único de escrita."
//
// CAMPO A CAMPO, e não um JSON do registro inteiro, porque a pergunta real
// nunca é "como estava o cliente em março?" e sim "QUEM mudou o valor, QUANDO
// e POR QUÊ?". Guardar o objeto todo obriga a diferenciar dois JSONs para
// responder isso, e ninguém faz isso na hora da dúvida.
//
// APPEND-ONLY de verdade: a regra está no BANCO (trigger que recusa UPDATE e
// DELETE), não na aplicação. Trilha que o próprio sistema pode reescrever não
// é trilha — é rascunho.
// ===========================================================================

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  REVERSE
}

/// De onde partiu a mudança. Import e job precisam ser distinguíveis de
/// gente: metade das dúvidas de auditoria é "isso fui eu ou foi a planilha?".
enum AuditOrigin {
  UI
  IMPORT
  JOB
  API
  MIGRATION
}

model AuditLog {
  id       String      @id @default(cuid())
  /// Nome do model tocado ("Billing", "Client", "CommercialTerm"...).
  entity   String
  entityId String
  action   AuditAction

  /// Campo alterado. Nulo em CREATE/DELETE, onde a linha inteira é o fato.
  field    String?
  oldValue String?
  newValue String?

  origin AuditOrigin @default(UI)
  /// Por quê. Obrigatório por REGRA DE NEGÓCIO em ajuste, estorno e write-off
  /// (01 §4.10) — o helper cobra; o banco aceita nulo para o caso trivial.
  reason String?

  actorId       String?
  actorEmail    String?
  /// Amarra as N linhas de uma mesma operação (T7 de observabilidade).
  correlationId String?

  /// SEM chave estrangeira para User, de propósito. Com FK, apagar um
  /// usuário dispararia ON DELETE SET NULL — um UPDATE — e a trilha, que é
  /// append-only, seria alterada por cascata. Pior: a linha perderia o dono
  /// justamente no caso em que a auditoria mais importa. A coluna guarda o
  /// id como foi registrado, e continua servindo ao escopo por dono.
  ownerId String?

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([entity, entityId])
  @@index([createdAt])
  @@index([actorEmail])
  @@index([correlationId])
  @@index([ownerId])
}
